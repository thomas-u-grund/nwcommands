VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwexpand")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 338

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwexpand - Expand variable to network")
BEGIN
  TEXT tx_vars 20 20 260 ., label("Variables (define the network):")
  VARLIST vl_vars 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 520 244, label("Options")
  TEXT tx_cb_mode 20 54 260 ., label("Mode used to expand variable; default = same")
  COMBOBOX cb_mode 290 54 190 ., dropdownlist contents(list_mode) nomem option(mode)
  TEXT tx_cb_network 20 82 260 ., label("Apply node labels of netname")
  COMBOBOX cb_network 290 82 190 ., dropdown contents(netlist) nomem option(network)
  TEXT tx_sp_nodes 20 110 260 ., label("Size of new network; default = _N - an explicit nodes(1) for a genuine 1-node network is honored")
  SPINNER sp_nodes 290 110 70 ., default(0) max(999999) min(-999999) nomem option(nodes)
  TEXT tx_cx_xvars 20 138 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 290 138 190 ., label("xvars") option(xvars)
  TEXT tx_cb_name 20 166 260 ., label("name of the new random network; default = {it:_varname")
  COMBOBOX cb_name 290 166 190 ., dropdown contents(netlist) nomem option()
  TEXT tx_ed_labs 20 194 260 ., label("overwrite node labels")
  EDIT ed_labs 290 194 190 ., nomem option(labs)
  TEXT tx_cx_replace 20 222 260 ., label("If a network named newnetname already exists, drop it and use this name anyway (see nwset for the same convention)")
  CHECKBOX cx_replace 290 222 190 ., label("replace") option(replace)
  TEXT tx_cx_force 20 250 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 250 190 ., label("force") option(force)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_mode
BEGIN
	same
	dist
	distinv
	absdist
	absdistinv
	sender
	receiver
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwexpand"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwexpand " main.vl_vars
	beginoptions
		optionarg main.cb_mode
		optionarg main.cb_network
		optionarg main.sp_nodes
		option main.cx_xvars
		optionarg main.cb_name
		optionarg main.ed_labs
		option main.cx_replace
		option main.cx_force
	endoptions
	stata
END
