VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwmixing")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 394

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwmixing - E-I index and mixing table for a categorical node attribute")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 300, label("Options")
  TEXT tx_vr_attribute 20 54 260 ., label("Categorical node attribute to cross-tabulate")
  VARNAME vr_attribute 290 54 190 ., nomem option(attribute)
  TEXT tx_cx_eiplot 20 82 260 ., label("Plot QAP null distribution of the E-I index")
  CHECKBOX cx_eiplot 290 82 190 ., label("eiplot") option(eiplot)
  TEXT tx_ed_eiplotoption 20 110 260 ., label("eiplot: further kdensity graph options")
  EDIT ed_eiplotoption 290 110 190 ., nomem option(eiplotoptions)
  TEXT tx_cx_plot 20 138 260 ., label("Bar plot of the ego/alter mixing table")
  CHECKBOX cx_plot 290 138 190 ., label("plot") option(plot)
  TEXT tx_ed_plotoptions 20 166 260 ., label("plot: further graph options")
  EDIT ed_plotoptions 290 166 190 ., nomem option(plotoptions)
  TEXT tx_sp_permutations 20 194 260 ., label("QAP permutations for the E-I index")
  SPINNER sp_permutations 290 194 70 ., default(100) max(999999) min(1) nomem option(permutations)
  TEXT tx_ed_save 20 222 260 ., label("File for QAP draws and observed E-I index")
  EDIT ed_save 290 222 190 ., nomem option(save)
  TEXT tx_name 20 250 260 ., label("name of the graphs (name_plot, name_eiplot)")
  EDIT ed_name 290 250 190 ., nomem option(name)
  TEXT tx_saving 20 278 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 278 190 ., save nomem option(saving)
  TEXT tx_export 20 306 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 306 190 ., save nomem option(export)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwmixing"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.vr_attribute
	put "nwmixing " main.cb_net
	beginoptions
		optionarg main.vr_attribute
		option main.cx_eiplot
		optionarg main.ed_eiplotoption
		option main.cx_plot
		optionarg main.ed_plotoptions
		optionarg main.sp_permutations
		optionarg main.ed_save
		optionarg main.ed_name
		optionarg main.fi_saving
		optionarg main.fi_export
	endoptions
	stata
END
