VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwmixing")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 310

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwmixing - E-I index and mixing table for a categorical node attribute")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_vr_attribute 20 54 260 ., label("Categorical (string or numeric) node attribute to cross-tabulate")
  VARNAME vr_attribute 290 54 190 ., nomem option(attribute)
  TEXT tx_cx_eiplot 20 82 260 ., label("Plot the null (QAP-permutation) distribution of the E-I index, with the observed")
  CHECKBOX cx_eiplot 290 82 190 ., label("eiplot") option(eiplot)
  TEXT tx_ed_eiplotoption 20 110 260 ., label("Additional options forwarded to the 's own")
  EDIT ed_eiplotoption 290 110 190 ., nomem option(eiplotoptions)
  TEXT tx_cx_plot 20 138 260 ., label("Plot the ego/alter mixing table via")
  CHECKBOX cx_plot 290 138 190 ., label("plot") option(plot)
  TEXT tx_ed_plotoptions 20 166 260 ., label("Additional options forwarded to 's own")
  EDIT ed_plotoptions 290 166 190 ., nomem option(plotoptions)
  TEXT tx_sp_permutations 20 194 260 ., label("Number of QAP permutations for the E-I index's own null")
  SPINNER sp_permutations 290 194 70 ., default(100) max(999999) min(-999999) nomem option(permutations)
  TEXT tx_ed_save 20 222 260 ., label("Save the QAP permutation draws (variable ) and the")
  EDIT ed_save 290 222 190 ., nomem option(save)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwmixing"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.vr_attribute
	put "nwmixing " main.cb_net
	beginoptions
		optionarg main.vr_attribute
		option main.cx_eiplot
		optionarg main.ed_eiplotoption
		option main.cx_plot
		optionarg main.ed_plotoptions
		optionarg main.sp_permutations
		optionarg main.ed_save
	endoptions
	stata
END
