VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwnclan")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwnclan - Maximal n-clan enumeration")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 160, label("Options")
  TEXT tx_sp_n 20 54 260 ., label("Maximum geodesic distance allowed between any two members; default = 2")
  SPINNER sp_n 290 54 70 ., default(2) max(999999) min(-999999) nomem option(n)
  TEXT tx_ed_generate 20 82 260 ., label("Name of the Stata variable that stores each node's largest maximal-n-clan member")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 110 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
  TEXT tx_sp_minsize 20 138 260 ., label("Smallest n-clan size to report; default = 3")
  SPINNER sp_minsize 290 138 70 ., default(3) max(999999) min(-999999) nomem option(minsize)
  TEXT tx_cx_silent 20 166 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwnclan"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwnclan " main.cb_net
	beginoptions
		optionarg main.sp_n
		optionarg main.ed_generate
		option main.cx_replace
		optionarg main.sp_minsize
		option main.cx_silent
	endoptions
	stata
END
