VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwnoderename")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwnoderename - Rename a single node in a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_ed_old 20 54 260 ., label("Old")
  EDIT ed_old 290 54 190 ., nomem option(old)
  TEXT tx_ed_new 20 82 260 ., label("New")
  EDIT ed_new 290 82 190 ., nomem option(new)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwnoderename"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_old
	require main.ed_new
	put "nwnoderename " main.cb_net
	beginoptions
		optionarg main.ed_old
		optionarg main.ed_new
	endoptions
	stata
END
