VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcoreperiphery")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 338

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcoreperiphery - Discrete core-periphery detection")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 244, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Required. Variable for core membership")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_ed_measure 20 110 260 ., label("Tie values (valued) or ties only (binary)")
  EDIT ed_measure 290 110 190 ., nomem option(measure)
  TEXT tx_sp_maxiter 20 138 260 ., label("Maximum local-search sweeps; default = 100")
  SPINNER sp_maxiter 290 138 70 ., default(100) max(999999) min(1) nomem option(maxiter)
  TEXT tx_sp_restarts 20 166 260 ., label("Number of starts, best kept; default = 1")
  SPINNER sp_restarts 290 166 70 ., default(1) max(999999) min(1) nomem option(restarts)
  TEXT tx_ed_seed 20 194 260 ., label("Seed for random starts (restarts 2 or more)")
  EDIT ed_seed 290 194 190 ., nomem option(seed)
  TEXT tx_cx_silent 20 222 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 222 190 ., label("silent") option(silent)
  TEXT tx_cx_sym 20 250 260 ., label("Directed: symmetrize (default: refused)")
  CHECKBOX cx_sym 290 250 190 ., label("sym") option(symmetrize)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcoreperiphery"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_generate
	put "nwcoreperiphery " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		optionarg main.ed_measure
		optionarg main.sp_maxiter
		optionarg main.sp_restarts
		optionarg main.ed_seed
		option main.cx_silent
		option main.cx_sym
	endoptions
	stata
END
