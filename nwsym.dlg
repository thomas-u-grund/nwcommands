VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsym")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsym - Symmetrize network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_cx_check 20 54 260 ., label("Check if network is symmetric (regardless of whether is declared as directed or ")
  CHECKBOX cx_check 290 54 190 ., label("check") option(check)
  TEXT tx_ed_generate 20 82 260 ., label("Save symmetrization as new network")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_cx_noreplace 20 110 260 ., label("Do not symmetrize in place; requires  (errors otherwise, since there would be no")
  CHECKBOX cx_noreplace 290 110 190 ., label("noreplace") option(noreplace)
  TEXT tx_ed_mode 20 138 260 ., label("Logic for creating an undirected tie")
  EDIT ed_mode 290 138 190 ., nomem option(mode)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsym"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsym " main.cb_net
	beginoptions
		option main.cx_check
		optionarg main.ed_generate
		option main.cx_noreplace
		optionarg main.ed_mode
	endoptions
	stata
END
