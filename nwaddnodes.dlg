VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwaddnodes")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwaddnodes - Add nodes to network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_ed_nodenames 20 54 260 ., label("Node identifiers separated by comma")
  EDIT ed_nodenames 290 54 190 ., nomem option(nodenames)
  TEXT tx_ed_generate 20 82 260 ., label("Save as new network")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_cx_xvars 20 110 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 110 190 ., label("xvars") option(xvars)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwaddnodes"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_nodenames
	put "nwaddnodes " main.cb_net
	beginoptions
		optionarg main.ed_nodenames
		optionarg main.ed_generate
		option main.cx_xvars
	endoptions
	stata
END
