VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdropnodes")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdropnodes - Drop nodes from a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_cx_xvars 20 54 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 54 190 ., label("xvars") option(xvars)
  TEXT tx_ed_nodes 20 82 260 ., label("of  to be dropped")
  EDIT ed_nodes 290 82 190 ., nomem option(nodes)
  TEXT tx_ed_keepmat 20 110 260 ., label("Mata  x 1 matrix; 0 = drop, 1 = keep")
  EDIT ed_keepmat 290 110 190 ., nomem option(keepmat)
  TEXT tx_vl_attributes 20 138 260 ., label("Attribute variables that are included in the drop")
  VARLIST vl_attributes 290 138 190 ., nomem option(attributes)
  TEXT tx_cx_netonly 20 166 260 ., label("Only drops the network, but keeps all Stata variables")
  CHECKBOX cx_netonly 290 166 190 ., label("netonly") option(netonly)
  TEXT tx_cb_generate 20 194 260 ., label("Generates a new network and does not overwrite the original network")
  COMBOBOX cb_generate 290 194 190 ., dropdown contents(netlist) nomem option(generate)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdropnodes"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdropnodes " main.cb_net
	beginoptions
		option main.cx_xvars
		optionarg main.ed_nodes
		optionarg main.ed_keepmat
		optionarg main.vl_attributes
		option main.cx_netonly
		optionarg main.cb_generate
	endoptions
	stata
END
