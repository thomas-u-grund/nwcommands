VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwpref")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwpref - Generate a preferential-attachment network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 1030 188, label("Options")
  TEXT tx_ed_weights 20 54 260 ., label("probabilities p_k for tie weights k")
  EDIT ed_weights 290 54 190 ., nomem option(weights)
  TEXT tx_ed_labs 20 82 260 ., label("Labs")
  EDIT ed_labs 290 82 190 ., nomem option(labs)
  TEXT tx_sp_ntimes 20 110 260 ., label("number of small-world networks to be generated; default = 1")
  SPINNER sp_ntimes 290 110 70 ., default(1) max(999999) min(-999999) nomem option(ntimes)
  TEXT tx_ed_vars 20 138 260 ., label("Vars")
  EDIT ed_vars 290 138 190 ., nomem option(vars)
  TEXT tx_ed_stub 20 166 260 ., label("Stub")
  EDIT ed_stub 290 166 190 ., nomem option(stub)
  TEXT tx_ed_name 20 194 260 ., label("name of the new network")
  EDIT ed_name 290 194 190 ., nomem option(name)
  TEXT tx_sp_m0 530 54 260 ., label("number of connected nodes at start; default = 2")
  SPINNER sp_m0 800 54 70 ., default(2) max(999999) min(-999999) nomem option(m0)
  TEXT tx_sp_m 530 82 260 ., label("number of connections each new node forms; default = 2")
  SPINNER sp_m 800 82 70 ., default(2) max(999999) min(-999999) nomem option(m)
  TEXT tx_ed_prob 530 110 260 ., label("probability that new node connects to existing nodes uniformly at random; defaul")
  EDIT ed_prob 800 110 100 ., numonly nomem option(prob)
  TEXT tx_cx_undirected 530 138 260 ., label("generate an undirected network; default = directed")
  CHECKBOX cx_undirected 800 138 190 ., label("undirected") option(undirected)
  TEXT tx_cx_xvars 530 166 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 800 166 190 ., label("xvars") option(xvars)
  TEXT tx_cx_noreplace 530 194 260 ., label("reserved; currently a no-op - the create/replace collision guard on  already app")
  CHECKBOX cx_noreplace 800 194 190 ., label("noreplace") option(noreplace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwpref"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwpref " main.cb_net
	beginoptions
		optionarg main.ed_weights
		optionarg main.ed_labs
		optionarg main.sp_ntimes
		optionarg main.ed_vars
		optionarg main.ed_stub
		optionarg main.ed_name
		optionarg main.sp_m0
		optionarg main.sp_m
		optionarg main.ed_prob
		option main.cx_undirected
		option main.cx_xvars
		option main.cx_noreplace
	endoptions
	stata
END
