VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwrecode")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwrecode - Recode network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_ed_into 20 54 260 ., label("Into")
  EDIT ed_into 290 54 190 ., nomem option(into)
  TEXT tx_cb_generate 20 82 260 ., label("nwgenerate {it:} containing transformed")
  COMBOBOX cb_generate 290 82 190 ., dropdown contents(netlist) nomem option(generate)
  TEXT tx_ed_prefix 20 110 260 ., label("generate new networks with  prefix")
  EDIT ed_prefix 290 110 190 ., nomem option(prefix)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwrecode"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwrecode " main.cb_net
	beginoptions
		optionarg main.ed_into
		optionarg main.cb_generate
		optionarg main.ed_prefix
	endoptions
	stata
END
