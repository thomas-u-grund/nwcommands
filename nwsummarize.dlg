VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsummarize")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsummarize - Summarize a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 160, label("Options")
  TEXT tx_cx_mat 20 54 260 ., label("Display adjacency matrix of the network")
  CHECKBOX cx_mat 290 54 190 ., label("mat") option(mat)
  TEXT tx_cx_matonly 20 82 260 ., label("Only display adjacency matrix of the network")
  CHECKBOX cx_matonly 290 82 190 ., label("matonly") option(matonly)
  TEXT tx_cx_detail 20 110 260 ., label("Calculate additional network measures, e.g. centralization, transitivity")
  CHECKBOX cx_detail 290 110 190 ., label("detail") option(detail)
  TEXT tx_ed_save 20 138 260 ., label("Save network measures in file")
  EDIT ed_save 290 138 190 ., nomem option(save)
  TEXT tx_cx_silent 20 166 260 ., label("Compute and return results without displaying anything")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsummarize"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsummarize " main.cb_net
	beginoptions
		option main.cx_mat
		option main.cx_matonly
		option main.cx_detail
		optionarg main.ed_save
		option main.cx_silent
	endoptions
	stata
END
