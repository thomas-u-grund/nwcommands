VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwfromedge")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwfromedge - Imports network data from edgelist")
BEGIN
  TEXT tx_vars 20 20 260 ., label("Variables (define the network):")
  VARLIST vl_vars 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 1030 188, label("Options")
  TEXT tx_cx_overwrite 20 54 260 ., label("forwarded to  governing whether this command's own generated Stata variables ove")
  CHECKBOX cx_overwrite 290 54 190 ., label("overwrite") option(overwrite)
  TEXT tx_cx_replace 20 82 260 ., label("if a network named  already exists, drop it and use this name anyway (see  for t")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_ed_labprefix 20 110 260 ., label("prefix used for auto-generated node labels when / are numeric and  is not specif")
  EDIT ed_labprefix 290 110 190 ., nomem option(labprefix)
  TEXT tx_cx_noclear 20 138 260 ., label("do not clear existing dataset")
  CHECKBOX cx_noclear 290 138 190 ., label("noclear") option(noclear)
  TEXT tx_cx_xvars 20 166 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 290 166 190 ., label("xvars") option(xvars)
  TEXT tx_cb_name 20 194 260 ., label("name of the new network; default =")
  COMBOBOX cb_name 290 194 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_ed_labs 530 54 260 ., label("overwrite node labels")
  EDIT ed_labs 800 54 190 ., nomem option(labs)
  TEXT tx_cx_directed 530 82 260 ., label("force the network to be directed (alias: )")
  CHECKBOX cx_directed 800 82 190 ., label("directed") option(directed)
  TEXT tx_cx_undirected 530 110 260 ., label("force the network to be undirected (alias: )")
  CHECKBOX cx_undirected 800 110 190 ., label("undirected") option(undirected)
  TEXT tx_cx_forcedirecte 530 138 260 ., label("Forcedirected")
  CHECKBOX cx_forcedirecte 800 138 190 ., label("forcedirected") option(forcedirected)
  TEXT tx_cx_forceundirec 530 166 260 ., label("Forceundirected")
  CHECKBOX cx_forceundirec 800 166 190 ., label("forceundirected") option(forceundirected)
  TEXT tx_cx_twomode 530 194 260 ., label("declare a two-mode network instead (alias for nw2fromedge)")
  CHECKBOX cx_twomode 800 194 190 ., label("twomode") option(twomode)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwfromedge"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwfromedge " main.vl_vars
	beginoptions
		option main.cx_overwrite
		option main.cx_replace
		optionarg main.ed_labprefix
		option main.cx_noclear
		option main.cx_xvars
		optionarg main.cb_name
		optionarg main.ed_labs
		option main.cx_directed
		option main.cx_undirected
		option main.cx_forcedirecte
		option main.cx_forceundirec
		option main.cx_twomode
	endoptions
	stata
END
