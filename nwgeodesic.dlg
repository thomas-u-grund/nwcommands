VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwgeodesic")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 450

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwgeodesic - Calculate shortest paths between nodes")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 1030 358, label("Options")
  TEXT tx_cx_nwreplace 20 54 260 ., label("Overwrite existing network")
  CHECKBOX cx_nwreplace 290 54 190 ., label("nwreplace") option(nwreplace)
  TEXT tx_cx_force 20 82 260 ., label("Allow large valued networks without the plugin")
  CHECKBOX cx_force 290 82 190 ., label("force") option(force)
  TEXT tx_cx_noreplace 20 110 260 ., label("Do not replace an existing distance network")
  CHECKBOX cx_noreplace 290 110 190 ., label("noreplace") option(noreplace)
  TEXT tx_ed_name 20 138 260 ., label("Name of distance network; default = _geodesic")
  EDIT ed_name 290 138 190 ., nomem option(name)
  TEXT tx_ed_alpha 20 166 260 ., label("Deal with valued networks")
  EDIT ed_alpha 290 166 100 ., numonly nomem option(alpha)
  TEXT tx_cx_xvars 530 54 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 800 54 190 ., label("xvars") option(xvars)
  TEXT tx_ed_unconnected 530 82 260 ., label("Path length between unconnected nodes")
  EDIT ed_unconnected 800 82 190 ., nomem option(unconnected)
  TEXT tx_cx_sym 530 110 260 ., label("Calculate distances from symmetrized network")
  CHECKBOX cx_sym 800 110 190 ., label("sym") option(sym)
  TEXT tx_ed_symopt 530 138 260 ., label("Options for sym (see help nwsym)")
  EDIT ed_symopt 800 138 190 ., nomem option(symopt)
  TEXT tx_ed_generate 530 166 260 ., label("Variable for each node's eccentricity")
  EDIT ed_generate 800 166 190 ., nomem option(generate)
  TEXT tx_cx_binary 530 194 260 ., label("Ignore tie values of a valued network")
  CHECKBOX cx_binary 290 194 190 ., label("binary") option(binary)
  TEXT tx_plot 20 222 260 ., label("Draw a histogram of the geodesic distances")
  CHECKBOX cx_plot 290 222 190 ., label("plot") option(plot)
  TEXT tx_average 20 250 260 ., label("plot: dashed line at the mean distance")
  CHECKBOX cx_average 290 250 190 ., label("average") option(average)
  TEXT tx_gname 20 278 260 ., label("Name of the plot graph; default = geodesic")
  EDIT ed_gname 290 278 190 ., nomem option(gname)
  TEXT tx_saving 20 306 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 306 190 ., save nomem option(saving)
  TEXT tx_export 20 334 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 334 190 ., save nomem option(export)
  TEXT tx_ed_save 20 362 260 ., label("Several networks: save one row each to this file")
  EDIT ed_save 290 362 190 ., nomem option(save)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwgeodesic"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.ed_alpha.isneq("") & !main.ed_alpha.isnumlist() {
		stopbox stop "alpha: enter a number."
	}
	put "nwgeodesic " main.cb_net
	beginoptions
		option main.cx_nwreplace
		option main.cx_force
		option main.cx_noreplace
		optionarg main.ed_name
		optionarg main.ed_alpha
		option main.cx_xvars
		optionarg main.ed_unconnected
		option main.cx_sym
		optionarg main.ed_symopt
		optionarg main.ed_generate
		option main.cx_binary
		option main.cx_plot
		option main.cx_average
		optionarg main.ed_gname
		optionarg main.fi_saving
		optionarg main.fi_export
		optionarg main.ed_save
	endoptions
	stata
END
