VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwgeodesic")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwgeodesic - Calculate shortest paths between nodes")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 1030 160, label("Options")
  TEXT tx_cx_nwreplace 20 54 260 ., label("Overwrite existing network")
  CHECKBOX cx_nwreplace 290 54 190 ., label("nwreplace") option(nwreplace)
  TEXT tx_cx_force 20 82 260 ., label("force distance calculation on a valued network exceeding 100 nodes (potentially ")
  CHECKBOX cx_force 290 82 190 ., label("force") option(force)
  TEXT tx_cx_noreplace 20 110 260 ., label("Noreplace")
  CHECKBOX cx_noreplace 290 110 190 ., label("noreplace") option(noreplace)
  TEXT tx_ed_name 20 138 260 ., label("Name of the new distance network; default =")
  EDIT ed_name 290 138 190 ., nomem option(name)
  TEXT tx_ed_alpha 20 166 260 ., label("Deal with valued networks")
  EDIT ed_alpha 290 166 100 ., numonly nomem option(alpha)
  TEXT tx_cx_xvars 530 54 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 800 54 190 ., label("xvars") option(xvars)
  TEXT tx_ed_unconnected 530 82 260 ., label("Define the length of the path between two unconnected nodes")
  EDIT ed_unconnected 800 82 190 ., nomem option(unconnected)
  TEXT tx_cx_sym 530 110 260 ., label("Calculate distances from symmetrized network")
  CHECKBOX cx_sym 800 110 190 ., label("sym") option(sym)
  TEXT tx_ed_symopt 530 138 260 ., label("Options controlling the symmetrization when  is specified (see )")
  EDIT ed_symopt 800 138 190 ., nomem option(symopt)
  TEXT tx_ed_generate 530 166 260 ., label("Name of the Stata variable that stores each node's eccentricity; default =")
  EDIT ed_generate 800 166 190 ., nomem option(generate)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwgeodesic"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwgeodesic " main.cb_net
	beginoptions
		option main.cx_nwreplace
		option main.cx_force
		option main.cx_noreplace
		optionarg main.ed_name
		optionarg main.ed_alpha
		option main.cx_xvars
		optionarg main.ed_unconnected
		option main.cx_sym
		optionarg main.ed_symopt
		optionarg main.ed_generate
	endoptions
	stata
END
