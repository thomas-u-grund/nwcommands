VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwtabulate")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwtabulate - One-way table of dyads")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_vr_attribute 20 54 260 ., label("Node-level attribute")
  VARNAME vr_attribute 290 54 190 ., nomem option(attribute)
  TEXT tx_plot 20 82 260 ., label("draw the table as bars")
  CHECKBOX cx_plot 290 82 190 ., label("plot") option(plot)
  TEXT tx_eiplot 20 110 260 ., label("plot E-I null distribution (needs attribute)")
  CHECKBOX cx_eiplot 290 110 190 ., label("eiplot") option(eiplot)
  TEXT tx_name 20 138 260 ., label("name of the graphs (name_plot, name_eiplot)")
  EDIT ed_name 290 138 190 ., nomem option(name)
  TEXT tx_saving 20 166 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 166 190 ., save nomem option(saving)
  TEXT tx_export 20 194 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 194 190 ., save nomem option(export)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwtabulate"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwtabulate " main.cb_net
	beginoptions
		optionarg main.vr_attribute
		option main.cx_plot
		option main.cx_eiplot
		optionarg main.ed_name
		optionarg main.fi_saving
		optionarg main.fi_export
	endoptions
	stata
END
