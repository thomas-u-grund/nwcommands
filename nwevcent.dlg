VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwevcent")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwevcent - Calculate eigenvector centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_cx_sym 20 54 260 ., label("Symmetrize first (larger of the two tie values)")
  CHECKBOX cx_sym 290 54 190 ., label("sym") option(symmetrize)
  TEXT tx_cx_weighted 20 82 260 ., label("Use the tie values of a valued network")
  CHECKBOX cx_weighted 290 82 190 ., label("weighted") option(weighted)
  TEXT tx_vr_generate 20 110 260 ., label("Required. Variable for eigenvector centrality")
  VARNAME vr_generate 290 110 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 138 260 ., label("Replace an existing centrality variable")
  CHECKBOX cx_replace 290 138 190 ., label("replace") option(replace)
  TEXT tx_cx_binary 20 166 260 ., label("Ignore tie values (default: use them)")
  CHECKBOX cx_binary 290 166 190 ., label("binary") option(binary)
  TEXT tx_cx_out 20 194 260 ., label("Directed: use outgoing ties (default: incoming)")
  CHECKBOX cx_out 290 194 190 ., label("out") option(out)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwevcent"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.vr_generate
	put "nwevcent " main.cb_net
	beginoptions
		option main.cx_sym
		option main.cx_weighted
		optionarg main.vr_generate
		option main.cx_replace
		option main.cx_binary
		option main.cx_out
	endoptions
	stata
END
