VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdyads")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 214

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdyads - Dyad census")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 128, label("Options")
  TEXT tx_plot 20 54 260 ., label("draw the dyad census as a picture")
  CHECKBOX cx_plot 290 54 190 ., label("plot") option(plot)
  TEXT tx_name 20 82 260 ., label("name of the graph; default = dyads")
  EDIT ed_name 290 82 190 ., nomem option(name)
  TEXT tx_saving 20 110 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 110 190 ., save nomem option(saving)
  TEXT tx_export 20 138 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 138 190 ., save nomem option(export)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdyads"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdyads " main.cb_net
	beginoptions
		option main.cx_plot
		optionarg main.ed_name
		optionarg main.fi_saving
		optionarg main.fi_export
	endoptions
	stata
END
