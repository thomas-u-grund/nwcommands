VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwconstraint")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwconstraint - Calculate Burt's constraint")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_ed_name 20 54 260 ., label("Name of the new constraint network")
  EDIT ed_name 290 54 190 ., nomem option(name)
  TEXT tx_cx_replace 20 82 260 ., label("Replace an existing network of that name")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwconstraint"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwconstraint " main.cb_net
	beginoptions
		optionarg main.ed_name
		option main.cx_replace
	endoptions
	stata
END
