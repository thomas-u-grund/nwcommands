VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwutility")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwutility - Utility scores (Jackson and Wolinsky 1996)")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 160, label("Options")
  TEXT tx_ed_benefit 20 54 260 ., label("benefit from connected node; default = 1")
  EDIT ed_benefit 290 54 100 ., numonly nomem option(benefit)
  TEXT tx_ed_cost 20 82 260 ., label("cost of connection; default = 1")
  EDIT ed_cost 290 82 100 ., numonly nomem option(cost)
  TEXT tx_cb_intrvalue 20 110 260 ., label("Value w_ij of a connection; default = 1")
  COMBOBOX cb_intrvalue 290 110 190 ., dropdown contents(netlist) nomem option(intrvalue)
  TEXT tx_cb_intrcost 20 138 260 ., label("Cost y_ij of a direct tie; default = cost")
  COMBOBOX cb_intrcost 290 138 190 ., dropdown contents(netlist) nomem option(intrcost)
  TEXT tx_cx_force 20 166 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 166 190 ., label("force") option(force)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwutility"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.ed_benefit.isneq("") & !main.ed_benefit.isnumlist() {
		stopbox stop "benefit from connected node: enter a number (or numbers)."
	}
	if main.ed_cost.isneq("") & !main.ed_cost.isnumlist() {
		stopbox stop "cost of connection: enter a number (or numbers)."
	}
	put "nwutility " main.cb_net
	beginoptions
		optionarg main.ed_benefit
		optionarg main.ed_cost
		optionarg main.cb_intrvalue
		optionarg main.cb_intrcost
		option main.cx_force
	endoptions
	stata
END
