VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwutility")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwutility - Calculate utility scores according to Jackson and Wollinsky...")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_ed_benefit 20 54 260 ., label("benefit from connected node; default = 1")
  EDIT ed_benefit 290 54 100 ., numonly nomem option(benefit)
  TEXT tx_ed_cost 20 82 260 ., label("cost of connection; default = 1")
  EDIT ed_cost 290 82 100 ., numonly nomem option(cost)
  TEXT tx_ed_intrvalue 20 110 260 ., label("intrinsic value w_ij a node i gives to a connection with node j; default = 1 for")
  EDIT ed_intrvalue 290 110 190 ., nomem option(intrvalue)
  TEXT tx_ed_intrcost 20 138 260 ., label("per-dyad cost y_ij, replacing the constant  for direct connections; default =  f")
  EDIT ed_intrcost 290 138 190 ., nomem option(intrcost)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwutility"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwutility " main.cb_net
	beginoptions
		optionarg main.ed_benefit
		optionarg main.ed_cost
		optionarg main.ed_intrvalue
		optionarg main.ed_intrcost
	endoptions
	stata
END
