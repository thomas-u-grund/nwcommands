VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsimmelian")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsimmelian - Calculate Simmelian ties")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_cb_name 20 54 260 ., label("Save Simmelian ties as new network; default")
  COMBOBOX cb_name 290 54 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cx_nwreplace 20 82 260 ., label("Nwreplace")
  CHECKBOX cx_nwreplace 290 82 190 ., label("nwreplace") option(nwreplace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsimmelian"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsimmelian " main.cb_net
	beginoptions
		optionarg main.cb_name
		option main.cx_nwreplace
	endoptions
	stata
END
