VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwregular")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 158

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwregular - Classes of regularly equivalent nodes")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 94, label("Options")
  TEXT tx_generate 20 54 260 ., label("Required. Name of the variable for the class of each node")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_replace 20 82 260 ., label("Overwrite an existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_silent 20 110 260 ., label("Do not show the table of classes")
  CHECKBOX cx_silent 290 110 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwregular"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_generate
	put "nwregular " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		option main.cx_silent
	endoptions
	stata
END
