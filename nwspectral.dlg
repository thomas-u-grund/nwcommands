VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwspectral")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwspectral - Graph Laplacian spectral analysis")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 160, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Name of the Stata variable that stores each node's own Fiedler-vector entry; def")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_bipartition 20 82 260 ., label("Also generate a two-way spectral partition (, or ) from the sign of the Fiedler ")
  CHECKBOX cx_bipartition 290 82 190 ., label("bipartition") option(bipartition)
  TEXT tx_ed_measure 20 110 260 ., label("Whether to use tie values () or only presence/absence of ties (); default =  for")
  EDIT ed_measure 290 110 190 ., nomem option(measure)
  TEXT tx_cx_replace 20 138 260 ., label("Replace existing variable(s)")
  CHECKBOX cx_replace 290 138 190 ., label("replace") option(replace)
  TEXT tx_cx_silent 20 166 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwspectral"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwspectral " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_bipartition
		optionarg main.ed_measure
		option main.cx_replace
		option main.cx_silent
	endoptions
	stata
END
