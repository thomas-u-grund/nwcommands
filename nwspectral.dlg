VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwspectral")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 478

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwspectral - Graph Laplacian spectral analysis")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 384, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Required. Variable for each node's Fiedler-vector entry")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_bipartition 20 82 260 ., label("Also generate a two-way partition from the sign of the Fiedler vector")
  CHECKBOX cx_bipartition 290 82 190 ., label("bipartition") option(bipartition)
  TEXT tx_ed_measure 20 110 260 ., label("Whether to use tie values (valued) or only presence/absence of ties (binary)")
  EDIT ed_measure 290 110 190 ., nomem option(measure)
  TEXT tx_cx_replace 20 138 260 ., label("Replace existing variable(s)")
  CHECKBOX cx_replace 290 138 190 ., label("replace") option(replace)
  TEXT tx_cx_silent 20 166 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
  TEXT tx_cx_force 20 194 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 194 190 ., label("force") option(force)
  TEXT tx_cx_onemode 20 222 260 ., label("Two-mode network: read the bipartite graph as a one-mode graph (else refused)")
  CHECKBOX cx_onemode 290 222 190 ., label("onemode") option(onemode)
  TEXT tx_plot 20 250 260 ., label("Draw the scree of the Laplacian eigenvalues")
  CHECKBOX cx_plot 290 250 190 ., label("plot") option(plot)
  TEXT tx_embedding 20 278 260 ., label("plot: add the 2nd and 3rd eigenvector as a scatter")
  CHECKBOX cx_embedding 290 278 190 ., label("embedding") option(embedding)
  TEXT tx_gname 20 306 260 ., label("name for the graph created by plot; default = spectral")
  EDIT ed_gname 290 306 190 ., nomem option(name)
  TEXT tx_cx_sym 20 334 260 ., label("directed network: analyse the symmetrized network (default: refused)")
  CHECKBOX cx_sym 290 334 190 ., label("sym") option(symmetrize)
  TEXT tx_saving 20 334 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 334 190 ., save nomem option(saving)
  TEXT tx_export 20 362 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 362 190 ., save nomem option(export)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwspectral"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_generate
	put "nwspectral " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_bipartition
		optionarg main.ed_measure
		option main.cx_replace
		option main.cx_silent
		option main.cx_force
		option main.cx_onemode
		option main.cx_plot
		option main.cx_embedding
		optionarg main.ed_gname
		optionarg main.fi_saving
		optionarg main.fi_export
		option main.cx_sym
	endoptions
	stata
END
