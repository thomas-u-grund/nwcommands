VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcommunity")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 422

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcommunity - Detect communities via the Louvain method or label...")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 328, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Required. Name of the Stata variable that stores community membership")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_ed_measure 20 110 260 ., label("Whether to use tie values (valued) or only presence/absence of ties (binary)")
  EDIT ed_measure 290 110 190 ., nomem option(measure)
  TEXT tx_cx_symmetrize 20 138 260 ., label("Symmetrize a directed network before detecting communities (required for directe")
  CHECKBOX cx_symmetrize 290 138 190 ., label("symmetrize") option(symmetrize)
  TEXT tx_ed_resolution 20 166 260 ., label("Resolution parameter (Reichardt-Bornholdt); must be > 0; only affects 's own sea")
  EDIT ed_resolution 290 166 100 ., numonly nomem option(resolution)
  TEXT tx_cb_algorithm 20 194 260 ., label("Community-detection algorithm; default = louvain")
  COMBOBOX cb_algorithm 290 194 190 ., dropdownlist contents(list_algorithm) nomem option(algorithm)
  TEXT tx_sp_seed 20 222 260 ., label("Set the random-number seed before detecting communities (for reproducibility wit")
  SPINNER sp_seed 290 222 70 ., default(-1) max(999999) min(-999999) nomem option(seed)
  TEXT tx_cx_silent 20 250 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 250 190 ., label("silent") option(silent)
  TEXT tx_cx_listall 20 278 260 ., label("Show the full table of communities (default: first 30)")
  CHECKBOX cx_listall 290 278 190 ., label("listall") option(listall)
  TEXT tx_cx_onemode 20 306 260 ., label("Two-mode network: Newman instead of Barber modularity (one-mode reading)")
  CHECKBOX cx_onemode 290 306 190 ., label("onemode") option(onemode)
  TEXT tx_ed_starts 20 334 260 ., label("Two-mode network: number of starting orders of the search (default 10)")
  EDIT ed_starts 290 334 100 ., numonly nomem option(starts)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_algorithm
BEGIN
	louvain
	labelprop
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcommunity"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwcommunity " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		optionarg main.ed_measure
		option main.cx_symmetrize
		optionarg main.ed_resolution
		optionarg main.cb_algorithm
		optionarg main.sp_seed
		option main.cx_silent
		option main.cx_listall
		option main.cx_onemode
		optionarg main.ed_starts
	endoptions
	stata
END
