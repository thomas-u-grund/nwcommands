VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcommunity")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 566

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcommunity - Detect communities: Louvain, Leiden, Infomap, label propagation")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 472, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Required. Variable for community membership")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_ed_measure 20 110 260 ., label("Tie values (valued) or ties only (binary)")
  EDIT ed_measure 290 110 190 ., nomem option(measure)
  TEXT tx_cx_symmetrize 20 138 260 ., label("Symmetrize first (required if directed)")
  CHECKBOX cx_symmetrize 290 138 190 ., label("symmetrize") option(symmetrize)
  TEXT tx_ed_resolution 20 166 260 ., label("Resolution > 0 (louvain, r(modularity)); def. 1")
  EDIT ed_resolution 290 166 100 ., numonly nomem option(resolution)
  TEXT tx_cb_algorithm 20 194 260 ., label("Detection algorithm; default = louvain")
  COMBOBOX cb_algorithm 290 194 190 ., dropdownlist contents(list_algorithm) nomem option(algorithm)
  TEXT tx_sp_seed 20 222 260 ., label("Random-number seed (-1 = none)")
  SPINNER sp_seed 290 222 70 ., default(-1) max(999999) min(-1) nomem option(seed)
  TEXT tx_cx_silent 20 250 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 250 190 ., label("silent") option(silent)
  TEXT tx_cx_listall 20 278 260 ., label("List all communities (default: first 30)")
  CHECKBOX cx_listall 290 278 190 ., label("listall") option(listall)
  TEXT tx_cx_onemode 20 306 260 ., label("Two-mode: Newman, not Barber, modularity")
  CHECKBOX cx_onemode 290 306 190 ., label("onemode") option(onemode)
  TEXT tx_ed_starts 20 334 260 ., label("Two-mode: no. of search starts (default 30)")
  EDIT ed_starts 290 334 100 ., numonly nomem option(starts)
  TEXT tx_ed_reps 20 362 260 ., label("dirtlpa: runs per no. of modules (default 10)")
  EDIT ed_reps 290 362 100 ., numonly nomem option(reps)
  TEXT tx_ed_minmodules 20 390 260 ., label("dirtlpa: minimum starting modules (default 4)")
  EDIT ed_minmodules 290 390 100 ., numonly nomem option(minmodules)
  TEXT tx_ed_beta 20 418 260 ., label("leiden: refinement randomness (default 0.01)")
  EDIT ed_beta 290 418 100 ., numonly nomem option(beta)
  TEXT tx_ed_iterations 20 446 260 ., label("leiden: passes; < 0 = until stable (default 2)")
  EDIT ed_iterations 290 446 100 ., nomem option(iterations)
  TEXT tx_ed_trials 20 474 260 ., label("leiden, infomap: runs, best kept (default 10)")
  EDIT ed_trials 290 474 100 ., numonly nomem option(trials)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_algorithm
BEGIN
	louvain
	leiden
	infomap
	labelprop
	dirtlpa
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcommunity"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.ed_minmodules.isneq("") & !main.ed_minmodules.isnumlist() {
		stopbox stop "dirtlpa, minimum starting modules: enter a number."
	}
	if main.ed_reps.isneq("") & !main.ed_reps.isnumlist() {
		stopbox stop "dirtlpa, runs per number of modules: enter a number."
	}
	if main.ed_resolution.isneq("") & !main.ed_resolution.isnumlist() {
		stopbox stop "Resolution: enter a number."
	}
	if main.ed_starts.isneq("") & !main.ed_starts.isnumlist() {
		stopbox stop "Number of search starts: enter a number."
	}
	if main.ed_beta.isneq("") & !main.ed_beta.isnumlist() {
		stopbox stop "leiden, refinement randomness: enter a number."
	}
	if main.ed_iterations.isneq("") & !main.ed_iterations.isnumlist() {
		stopbox stop "leiden, passes: enter a number."
	}
	if main.ed_trials.isneq("") & !main.ed_trials.isnumlist() {
		stopbox stop "leiden or infomap, number of runs: enter a number."
	}
	require main.ed_generate
	put "nwcommunity " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		optionarg main.ed_measure
		option main.cx_symmetrize
		optionarg main.ed_resolution
		optionarg main.cb_algorithm
		optionarg main.sp_seed
		option main.cx_silent
		option main.cx_listall
		option main.cx_onemode
		optionarg main.ed_starts
		optionarg main.ed_reps
		optionarg main.ed_minmodules
		optionarg main.ed_beta
		optionarg main.ed_iterations
		optionarg main.ed_trials
	endoptions
	stata
END
