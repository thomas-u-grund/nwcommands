VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwmovie")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1100 480

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwmovie - Animated HTML network movie (panel or event mode)")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s) - panel mode: one per wave; event mode: a single temporal network:")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem

  GROUPBOX gb_out 10 44 530 76, label("Output")
  TEXT tx_ed_fname 20 54 260 ., label("base filename for the output .html; default = movie")
  EDIT ed_fname 290 54 190 ., nomem option(fname)
  TEXT tx_cx_noopen 20 82 260 ., label("build the .html file but do not open it in a viewer")
  CHECKBOX cx_noopen 290 82 190 ., label("noopen") option(noopen)

  GROUPBOX gb_lay 10 126 530 132, label("Layout")
  TEXT tx_cb_layout 20 136 260 ., label("Layout algorithm (panel mode); see layout() of nwplot")
  COMBOBOX cb_layout 290 136 190 ., dropdown contents(list_layout) nomem option(layout)
  TEXT tx_cx_fixedlayout 20 164 260 ., label("compute one layout on the first network only and reuse it for every wave")
  CHECKBOX cx_fixedlayout 290 164 190 ., label("fixedlayout") option(fixedlayout)
  TEXT tx_sp_iterations 20 192 260 ., label("iterations for the layout algorithm; default = 500")
  SPINNER sp_iterations 290 192 70 ., default(500) max(999999) min(1) nomem option(iterations)
  TEXT tx_ed_duration 20 220 260 ., label("panel mode: milliseconds per wave-to-wave transition; default = 800")
  EDIT ed_duration 290 220 100 ., numonly nomem option(duration)
  TEXT tx_ed_easing 20 248 260 ., label("panel mode: Cytoscape.js easing name; default = ease-in-out-cubic")
  EDIT ed_easing 290 248 190 ., nomem option(easing)

  GROUPBOX gb_evt 10 266 530 76, label("Event mode")
  TEXT tx_ed_window 20 276 260 ., label("a tie fades out this many time units after its most recent event; omit to accumulate permanently")
  EDIT ed_window 290 276 100 ., numonly nomem option(window)
  TEXT tx_ed_speed 20 304 260 ., label("simulated event-time units per real second during playback; default = 1")
  EDIT ed_speed 290 304 100 ., numonly nomem option(speed)

  GROUPBOX gb_app 10 350 530 104, label("Appearance")
  TEXT tx_vr_color 20 360 260 ., label("color nodes by this variable")
  VARNAME vr_color 290 360 190 ., nomem option(color)
  TEXT tx_vr_symbol 20 388 260 ., label("shape nodes by this variable")
  VARNAME vr_symbol 290 388 190 ., nomem option(symbol)
  TEXT tx_vr_size 20 416 260 ., label("size nodes by this variable")
  VARNAME vr_size 290 416 190 ., nomem option(size)
  TEXT tx_vr_label 20 444 260 ., label("node labels from this variable")
  VARNAME vr_label 290 444 190 ., nomem option(label)

  GROUPBOX gb_pan 550 44 530 244, label("Styling by wave and edges")
  TEXT tx_cb_edgecolor 560 54 260 ., label("color edges by this other network (all waves)")
  COMBOBOX cb_edgecolor 830 54 190 ., dropdown contents(netlist) nomem option(edgecolor)
  TEXT tx_cb_edgesize 560 82 260 ., label("width edges by this other network (all waves)")
  COMBOBOX cb_edgesize 830 82 190 ., dropdown contents(netlist) nomem option(edgesize)
  TEXT tx_ed_colors 560 110 260 ., label("panel mode: one color variable per wave")
  EDIT ed_colors 830 110 190 ., nomem option(colors)
  TEXT tx_ed_symbols 560 138 260 ., label("panel mode: one shape variable per wave")
  EDIT ed_symbols 830 138 190 ., nomem option(symbols)
  TEXT tx_ed_sizes 560 166 260 ., label("panel mode: one size variable per wave")
  EDIT ed_sizes 830 166 190 ., nomem option(sizes)
  TEXT tx_ed_edgecolors 560 194 260 ., label("panel mode: one edge-color network per wave")
  EDIT ed_edgecolors 830 194 190 ., nomem option(edgecolors)
  TEXT tx_ed_edgesizes 560 222 260 ., label("panel mode: one edge-width network per wave")
  EDIT ed_edgesizes 830 222 190 ., nomem option(edgesizes)
  TEXT tx_ed_titles 560 250 260 ., label("panel mode: one double-quoted title per wave")
  EDIT ed_titles 830 250 190 ., nomem option(titles)
  GROUPBOX gb_pal 550 294 530 132, label("Palettes and scheme")
  TEXT tx_ed_colorpalette 560 304 260 ., label("node color palette (see nwplot)")
  EDIT ed_colorpalette 830 304 190 ., nomem option(colorpalette)
  TEXT tx_ed_edgecolorpalette 560 332 260 ., label("edge color palette (see nwplot)")
  EDIT ed_edgecolorpalette 830 332 190 ., nomem option(edgecolorpalette)
  TEXT tx_ed_symbolpalette 560 360 260 ., label("node shape palette (see nwplot)")
  EDIT ed_symbolpalette 830 360 190 ., nomem option(symbolpalette)
  TEXT tx_ed_scheme 560 388 260 ., label("graph scheme (see nwplot)")
  EDIT ed_scheme 830 388 190 ., nomem option(scheme)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_layout
BEGIN
	kk
	mds
	mdsclassical
	circle
	grid
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwmovie"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwmovie " main.cb_net
	beginoptions
		optionarg main.ed_fname
		option main.cx_noopen
		optionarg main.cb_layout
		option main.cx_fixedlayout
		optionarg main.sp_iterations
		optionarg main.ed_duration
		optionarg main.ed_easing
		optionarg main.ed_window
		optionarg main.ed_speed
		optionarg main.vr_color
		optionarg main.vr_symbol
		optionarg main.vr_size
		optionarg main.vr_label
		optionarg main.cb_edgecolor
		optionarg main.cb_edgesize
		optionarg main.ed_colors
		optionarg main.ed_symbols
		optionarg main.ed_sizes
		optionarg main.ed_edgecolors
		optionarg main.ed_edgesizes
		optionarg main.ed_titles
		optionarg main.ed_colorpalette
		optionarg main.ed_edgecolorpalette
		optionarg main.ed_symbolpalette
		optionarg main.ed_scheme
	endoptions
	stata
END
