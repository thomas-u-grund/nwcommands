VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwpreserve")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
POSITION 10 10 400 120

DIALOG main, title("nwpreserve - Preserve and restore network data")
BEGIN
  TEXT tx_note 20 20 360 40, label("Preserve and restore network data. Takes no arguments - click OK/Submit to run.")
END

PROGRAM command
BEGIN
	put "nwpreserve"
	stata
END
