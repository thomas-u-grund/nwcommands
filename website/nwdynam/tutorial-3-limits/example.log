. 
. * --- how the precision of 'recip' grows with the number of events ---
. foreach n in 60 150 300 631 {
  2.     quietly nwdynam first`n', inertia recip
  3.     matrix b = e(b)
  4.     matrix V = e(V)
  5.     display "events " %4.0f e(N) ":  recip = " %6.3f b[1,2] "   s.e. = " %6.3
> f sqrt(V[2,2])
  6. }
events   60:  recip =  4.147   s.e. =  0.593
events  150:  recip =  2.329   s.e. =  0.423
events  300:  recip =  1.985   s.e. =  0.229
events  631:  recip =  2.639   s.e. =  0.146

