. 
. * --- how the precision of 'recip' grows with the number of events ---
. foreach n in 60 120 240 439 {
  2.     quietly nwdynam first`n', inertia recip
  3.     matrix b = e(b)
  4.     matrix V = e(V)
  5.     display "events " %3.0f e(N) ":  recip = " %6.3f b[1,2] "   s.e. = " %6.3f sqrt(V[2,2])
  6. }
events  60:  recip =  0.314   s.e. =  0.876
events 120:  recip =  1.704   s.e. =  0.466
events 240:  recip =  1.730   s.e. =  0.264
events 439:  recip =  1.343   s.e. =  0.165

