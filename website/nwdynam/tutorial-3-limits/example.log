. 
. * --- the real log: the first 60 events, then all 439 ---
. * (the same 84 students in the risk set both times)
. import delimited "../data/calls_events.csv", clear
(encoding automatically selected: ISO-8859-1)
(3 vars, 439 obs)

. tempfile all

. save `all'
file /var/folders/hx/2zp2k5ps2y7d_6hx015fcr1h0000gn/T//S_10842.000001 saved as .dta format

. foreach n in 60 120 240 439 {
  2.     use `all', clear
  3.     keep in 1/`n'
  4.     levelsof sender, local(a) clean
  5.     levelsof receiver, local(b) clean
  6.     local seen : list a | b
  7.     local miss
  8.     forvalues i = 1/84 {
  9.         if !`: list i in seen' local miss `miss',`i'
 10.     }
 11.     local miss = substr("`miss'", 2, .)
 12.     nwset sender receiver, directed eventtime(eventtime) name(first`n')
 13.     nwaddnodes first`n', nodenames(`miss')
 14. }
