. * 8. Large networks
. clear

. quietly set obs 25000

. generate long a = _n

. generate long b = mod(_n, 25000) + 1

. nwset a b, edgelist name(ring) undirected

. mata: nwapi_nodes("ring"), nwapi_ties("ring")
           1       2
    +-----------------+
  1 |  25000   25000  |
    +-----------------+

. mata: E = nwapi_edgelist("ring")

. mata: E[1..3, .]
           1       2       3
    +-------------------------+
  1 |      1       2       1  |
  2 |      1   25000       1  |
  3 |      2       3       1  |
    +-------------------------+

. mata: E[rows(E), .]
           1       2       3
    +-------------------------+
  1 |  24999   25000       1  |
    +-------------------------+

. mata: d = nwapi_outdegree("ring")

. mata: min(d), max(d)
       1   2
