. mata:
------------------------------------------------- mata (type end to exit) --------
: P = nwapi_matrix("flomarriage")

: P = P*P

: _diag(P, 0)

: end
----------------------------------------------------------------------------------

. mata: st_local("labs", invtokens(nwapi_nodelabels("flomarriage")', ","))

. nwset, mat(P) name(paths2) labs(`labs') undirected

. nwsummarize paths2
