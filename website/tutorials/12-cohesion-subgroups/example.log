. do example.do

. * nwcommands tutorial 11: cohesion and subgroups
. * Requires the core nwcommands.
. 
. * 1. Components: who can reach whom?
. nwwebuse mesa, nwclear

. nwsummarize mesa
--------------------------------------------------
   Network name:  mesa
   Network id:  1
   Directed: false
   Valued: false
   Two-mode: false
   Nodes: 205
   Selfloop: false
   Edges: 203
   Minimum value:  0
   Maximum value:  1
   Density:  .00971
   Temporal: false

. nwcomponents mesa, generate(compid) silent

. display r(components)
68

. bysort compid: generate csize = _N

. tabulate csize

      csize |      Freq.     Percent        Cum.
------------+-----------------------------------
          1 |         57       27.80       27.80
          2 |          8        3.90       31.71
          3 |         12        5.85       37.56
          4 |          8        3.90       41.46
        120 |        120       58.54      100.00
------------+-----------------------------------
      Total |        205      100.00

. nwcomponents mesa, generate(lgc) lgc silent

. tabulate lgc

        lgc |      Freq.     Percent        Cum.
------------+-----------------------------------
          0 |         85       41.46       41.46
          1 |        120       58.54      100.00
------------+-----------------------------------
      Total |        205      100.00

