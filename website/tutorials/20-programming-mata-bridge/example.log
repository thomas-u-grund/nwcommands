. 
. * 4. A reusable command
. capture program drop nwreach2

. program nwreach2, rclass
  1.     syntax [anything(name=netname)], GENerate(name) [NETwork(name)]
  2.     _nwsyntax `netname'
  3.     _nwdatasync `netname'
  4.     confirm new variable `generate'
  5.     tempname A
  6.     nwtomata `netname', mat(`A')
  7.     quietly generate double `generate' = .
  8.     mata: st_store((1::`nodes'), "`generate'", nw_reach2(`A'))
  9.     if "`network'" != "" {
 10.         mata: _diag(`A', 0)
 11.         mata: `A' = ((`A' + `A'*`A') :> 0)
 12.         mata: _diag(`A', 0)
 13.         local undirected = cond("`directed'" == "false", "undirected", "")
 14.         nwset, mat(`A') name(`network') labs(`labs') `undirected'
 15.     }
 16.     mata: mata drop `A'
 17.     quietly summarize `generate'
 18.     return scalar mean = r(mean)
 19.     return local netname "`netname'"
 20. end

. 
. drop reach2

. nwreach2 flomarriage, generate(reach2) network(floreach2b)

