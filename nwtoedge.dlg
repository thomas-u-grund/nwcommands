VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwtoedge")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwtoedge - Convert network to edgelist")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 1030 188, label("Options")
  TEXT tx_cx_isolates0 20 54 260 ., label("reserved; not currently implemented")
  CHECKBOX cx_isolates0 290 54 190 ., label("isolates0") option(isolates0)
  TEXT tx_cx_compress 20 82 260 ., label("Compress edgelist")
  CHECKBOX cx_compress 290 82 190 ., label("compress") option(compress)
  TEXT tx_cx_upper 20 110 260 ., label("List only one entry per undirected dyad (the default; see  above) - has no effec")
  CHECKBOX cx_upper 290 110 190 ., label("upper") option(upper)
  TEXT tx_vl_egovars 20 138 260 ., label("Keep attributes of sending nodes")
  VARLIST vl_egovars 290 138 190 ., nomem option(egovars)
  TEXT tx_vl_altervars 20 166 260 ., label("Keep attributes of receiving nodes")
  VARLIST vl_altervars 290 166 190 ., nomem option(altervars)
  TEXT tx_cx_numeric 20 194 260 ., label("Return every possible node pair (a full node x node grid), not just actual ties;")
  CHECKBOX cx_numeric 290 194 190 ., label("numeric") option(numeric)
  TEXT tx_ed_ego 530 54 260 ., label("Sender of ties; default =")
  EDIT ed_ego 800 54 190 ., nomem option(ego)
  TEXT tx_ed_alter 530 82 260 ., label("Receiver of ties; default =")
  EDIT ed_alter 800 82 190 ., nomem option(alter)
  TEXT tx_cx_full 530 110 260 ., label("List both  and  for an undirected network's dyads, rather than only one entry pe")
  CHECKBOX cx_full 800 110 190 ., label("full") option(full)
  TEXT tx_cx_ignore2mode 530 138 260 ., label("Treat a two-mode network like a one-mode one - suppress the mode indicator that ")
  CHECKBOX cx_ignore2mode 800 138 190 ., label("ignore2mode") option(ignore2mode)
  TEXT tx_vl_comparevars 530 166 260 ., label("Add an ego/alter comparison column for each variable (e.g. , )")
  VARLIST vl_comparevars 800 166 190 ., nomem option(comparevars)
  TEXT tx_ed_comparemode 530 194 260 ., label("Comparison used for ; default =")
  EDIT ed_comparemode 800 194 190 ., nomem option(comparemode)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwtoedge"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwtoedge " main.cb_net
	beginoptions
		option main.cx_isolates0
		option main.cx_compress
		option main.cx_upper
		optionarg main.vl_egovars
		optionarg main.vl_altervars
		option main.cx_numeric
		optionarg main.ed_ego
		optionarg main.ed_alter
		option main.cx_full
		option main.cx_ignore2mode
		optionarg main.vl_comparevars
		optionarg main.ed_comparemode
	endoptions
	stata
END
