VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwtranspose")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwtranspose - Transpose a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_cb_generate 20 54 260 ., label("Save transpose as new network (alias: , matching the rest of this group)")
  COMBOBOX cb_generate 290 54 190 ., dropdown contents(netlist) nomem option(generate)
  TEXT tx_cb_name 20 82 260 ., label("Name")
  COMBOBOX cb_name 290 82 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cx_replace 20 110 260 ., label("if a network named  already exists, drop it and use this name anyway")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwtranspose"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwtranspose " main.cb_net
	beginoptions
		optionarg main.cb_generate
		optionarg main.cb_name
		option main.cx_replace
	endoptions
	stata
END
