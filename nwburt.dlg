VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwburt")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwburt - Calculate Burt structural hole measures")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_cx_dyadredundan 20 54 260 ., label("Save dyadic redundancy as new network")
  CHECKBOX cx_dyadredundan 290 54 190 ., label("dyadredundancy") option(dyadredundancy)
  TEXT tx_cx_dyadconstrai 20 82 260 ., label("Save dyadic constraint as new network")
  CHECKBOX cx_dyadconstrai 290 82 190 ., label("dyadconstraint") option(dyadconstraint)
  TEXT tx_cx_replace 20 110 260 ., label("Replace existing /// variables")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
  TEXT tx_cx_silent 20 138 260 ., label("Suppress summary output")
  CHECKBOX cx_silent 290 138 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwburt"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwburt " main.cb_net
	beginoptions
		option main.cx_dyadredundan
		option main.cx_dyadconstrai
		option main.cx_replace
		option main.cx_silent
	endoptions
	stata
END
