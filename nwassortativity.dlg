VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwassortativity")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwassortativity - Newman's assortativity coefficient")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_vr_attribute 20 54 260 ., label("Numeric node attribute to correlate across ties; default = each node's own degre")
  VARNAME vr_attribute 290 54 190 ., nomem option(attribute)
  TEXT tx_cx_silent 20 82 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 82 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwassortativity"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwassortativity " main.cb_net
	beginoptions
		optionarg main.vr_attribute
		option main.cx_silent
	endoptions
	stata
END
