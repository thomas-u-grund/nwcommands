VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwunab")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwunab - Unabbreviate network list")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_ed_min 20 54 260 ., label("Min")
  EDIT ed_min 290 54 190 ., nomem option(min)
  TEXT tx_ed_max 20 82 260 ., label("Max")
  EDIT ed_max 290 82 190 ., nomem option(max)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwunab"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwunab " main.cb_net
	beginoptions
		optionarg main.ed_min
		optionarg main.ed_max
	endoptions
	stata
END
