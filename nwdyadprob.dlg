VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdyadprob")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 310

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdyadprob - Generate a network based on tie probabilities")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_ed_weights 20 54 260 ., label("probabilities p_k for tie weights k")
  EDIT ed_weights 290 54 190 ., nomem option(weights)
  TEXT tx_ed_density 20 82 260 ., label("density of the new network")
  EDIT ed_density 290 82 190 ., nomem option(density)
  TEXT tx_ed_mat 20 110 260 ., label("Stata or Mata matrix with tie probabilities")
  EDIT ed_mat 290 110 190 ., nomem option(mat)
  TEXT tx_cb_name 20 138 260 ., label("name of the new random network")
  COMBOBOX cb_name 290 138 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_ed_labs 20 166 260 ., label("overwrite node labels")
  EDIT ed_labs 290 166 190 ., nomem option(labs)
  TEXT tx_cx_xvars 20 194 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 290 194 190 ., label("xvars") option(xvars)
  TEXT tx_cx_undirected 20 222 260 ., label("generate undirected network")
  CHECKBOX cx_undirected 290 222 190 ., label("undirected") option(undirected)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdyadprob"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdyadprob " main.cb_net
	beginoptions
		optionarg main.ed_weights
		optionarg main.ed_density
		optionarg main.ed_mat
		optionarg main.cb_name
		optionarg main.ed_labs
		option main.cx_xvars
		option main.cx_undirected
	endoptions
	stata
END
