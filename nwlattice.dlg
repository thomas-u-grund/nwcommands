VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwlattice")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwlattice - Generate a lattice network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 1030 160, label("Options")
  TEXT tx_cx_xwrap 20 54 260 ., label("wrap horizontally")
  CHECKBOX cx_xwrap 290 54 190 ., label("xwrap") option(xwrap)
  TEXT tx_cx_ywrap 20 82 260 ., label("wrap vertically")
  CHECKBOX cx_ywrap 290 82 190 ., label("ywrap") option(ywrap)
  TEXT tx_ed_name 20 110 260 ., label("name of the new network")
  EDIT ed_name 290 110 190 ., nomem option(name)
  TEXT tx_ed_labs 20 138 260 ., label("Labs")
  EDIT ed_labs 290 138 190 ., nomem option(labs)
  TEXT tx_ed_vars 20 166 260 ., label("new variables that are used for the network")
  EDIT ed_vars 290 166 190 ., nomem option(vars)
  TEXT tx_ed_stub 530 54 260 ., label("Stub")
  EDIT ed_stub 800 54 190 ., nomem option(stub)
  TEXT tx_cx_xvars 530 82 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 800 82 190 ., label("xvars") option(xvars)
  TEXT tx_cx_undirected 530 110 260 ., label("generate an undirected network; default = directed")
  CHECKBOX cx_undirected 800 110 190 ., label("undirected") option(undirected)
  TEXT tx_cx_noreplace 530 138 260 ., label("reserved; currently a no-op - the create/replace collision guard on  already app")
  CHECKBOX cx_noreplace 800 138 190 ., label("noreplace") option(noreplace)
  TEXT tx_sp_ntimes 530 166 260 ., label("number of networks to be generated; default = 1")
  SPINNER sp_ntimes 800 166 70 ., default(1) max(999999) min(-999999) nomem option(ntimes)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwlattice"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwlattice " main.cb_net
	beginoptions
		option main.cx_xwrap
		option main.cx_ywrap
		optionarg main.ed_name
		optionarg main.ed_labs
		optionarg main.ed_vars
		optionarg main.ed_stub
		option main.cx_xvars
		option main.cx_undirected
		option main.cx_noreplace
		optionarg main.sp_ntimes
	endoptions
	stata
END
