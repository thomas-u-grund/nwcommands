VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwinstall")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 304

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwinstall - Install Stata menu/dialogs")
BEGIN
  GROUPBOX gb_opt 10 10 1030 270, label("Options")
  TEXT tx_ed_menu 20 48 260 ., label("install in this menu; default = 'stUser'")
  EDIT ed_menu 290 48 190 ., nomem option(menu)
  TEXT tx_cx_usermenu 20 76 260 ., label("Rebuild the dialog menu items")
  CHECKBOX cx_usermenu 290 76 190 ., label("usermenu") option(usermenu)
  TEXT tx_cx_permanently 20 104 260 ., label("Install the menu and dialogs permanently")
  CHECKBOX cx_permanently 290 104 190 ., label("permanently") option(permanently)
  TEXT tx_cx_dialog 20 132 260 ., label("download the dialog boxes")
  CHECKBOX cx_dialog 290 132 190 ., label("dialog") option(dialog)
  TEXT tx_cx_remove 20 160 260 ., label("Remove 'Network Analysis' menu from Stata")
  CHECKBOX cx_remove 290 160 190 ., label("remove") option(remove)
  TEXT tx_cx_downloadoff 530 20 260 ., label("Rebuild the menu only, without downloading")
  CHECKBOX cx_downloadoff 800 20 190 ., label("downloadoff") option(downloadoff)
  TEXT tx_cx_help 530 48 260 ., label("download the help files")
  CHECKBOX cx_help 800 48 190 ., label("help") option(help)
  TEXT tx_cx_ado 530 76 260 ., label("download the core command (.ado) files")
  CHECKBOX cx_ado 800 76 190 ., label("ado") option(ado)
  TEXT tx_cx_ext 530 104 260 ., label("download the extension files")
  CHECKBOX cx_ext 800 104 190 ., label("ext") option(ext)
  TEXT tx_cx_all 530 132 260 ., label("Help, dialogs, commands; permanent menu")
  CHECKBOX cx_all 800 132 190 ., label("all") option(all)
  TEXT tx_ed_path 530 160 260 ., label("Folder of profile.do (blank = automatic)")
  EDIT ed_path 800 160 190 ., nomem option(path)
  TEXT tx_cx_localcopy 20 188 260 ., label("Copy from a local folder (no download)")
  CHECKBOX cx_localcopy 290 188 190 ., label("localcopy") option(localcopy)
  TEXT tx_ed_from 530 188 260 ., label("localcopy: source folder (default: current)")
  EDIT ed_from 800 188 190 ., nomem option(from)
  TEXT tx_ed_dest 20 216 260 ., label("localcopy: target folder (default: PERSONAL)")
  EDIT ed_dest 290 216 190 ., nomem option(dest)
  TEXT tx_cx_everything 20 244 260 ., label("Install the core and the seven model packages")
  CHECKBOX cx_everything 290 244 190 ., label("everything") option(everything)
  TEXT tx_cx_nogui 530 244 260 ., label("With all or everything: do not install the menu")
  CHECKBOX cx_nogui 800 244 190 ., label("nogui") option(nogui)
  TEXT tx_cx_dupcheck 20 20 260 ., label("Report duplicate dialog files (changes nothing)")
  CHECKBOX cx_dupcheck 290 20 190 ., label("dupcheck") option(dupcheck)
END

PROGRAM initialize
BEGIN
END

PROGRAM command
BEGIN
	put "nwinstall"
	beginoptions
		optionarg main.ed_menu
		option main.cx_usermenu
		option main.cx_permanently
		option main.cx_dialog
		option main.cx_remove
		option main.cx_downloadoff
		option main.cx_help
		option main.cx_ado
		option main.cx_ext
		option main.cx_all
		optionarg main.ed_path
		option main.cx_localcopy
		optionarg main.ed_from
		optionarg main.ed_dest
		option main.cx_everything
		option main.cx_nogui
		option main.cx_dupcheck
	endoptions
	stata
END
