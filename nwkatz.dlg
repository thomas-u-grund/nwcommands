VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwkatz")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwkatz - Calculate a Katz-inspired distance-decay centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_ed_alpha 20 54 260 ., label("penalization factor for calculation of weights; default = 1")
  EDIT ed_alpha 290 54 100 ., numonly nomem option(alpha)
  TEXT tx_ed_generate 20 82 260 ., label("variable name for Katz centrality scores; default =")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 110 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
  TEXT tx_cx_nosym 20 138 260 ., label("Nosym")
  CHECKBOX cx_nosym 290 138 190 ., label("nosym") option(nosym)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwkatz"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwkatz " main.cb_net
	beginoptions
		optionarg main.ed_alpha
		optionarg main.ed_generate
		option main.cx_replace
		option main.cx_nosym
	endoptions
	stata
END
