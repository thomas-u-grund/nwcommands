VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwimport")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 338

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwimport - Import network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 244, label("Options")
  TEXT tx_cb_type 20 54 260 ., label("Type")
  COMBOBOX cb_type 290 54 190 ., dropdownlist contents(list_type) nomem option(type)
  TEXT tx_cb_name 20 82 260 ., label("name of the imported network; default =")
  COMBOBOX cb_name 290 82 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cx_clear 20 110 260 ., label("same as")
  CHECKBOX cx_clear 290 110 190 ., label("clear") option(clear)
  TEXT tx_cx_nwclear 20 138 260 ., label("clear all data and networks")
  CHECKBOX cx_nwclear 290 138 190 ., label("nwclear") option(nwclear)
  TEXT tx_cx_nwappend 20 166 260 ., label("append to existing data")
  CHECKBOX cx_nwappend 290 166 190 ., label("nwappend") option(nwappend)
  TEXT tx_cx_xvars 20 194 260 ., label("also generate Stata variables for the imported network (see )")
  CHECKBOX cx_xvars 290 194 190 ., label("xvars") option(xvars)
  TEXT tx_cx_forcedirecte 20 222 260 ., label("force network to be directed")
  CHECKBOX cx_forcedirecte 290 222 190 ., label("forcedirected") option(forcedirected)
  TEXT tx_cx_forceundirec 20 250 260 ., label("force network to be undirected")
  CHECKBOX cx_forceundirec 290 250 190 ., label("forceundirected") option(forceundirected)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_type
BEGIN
	pajek
	ucinet
	matrix
	edgelist
	compressed
	gml
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwimport"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.cb_type
	put "nwimport " main.cb_net
	beginoptions
		optionarg main.cb_type
		optionarg main.cb_name
		option main.cx_clear
		option main.cx_nwclear
		option main.cx_nwappend
		option main.cx_xvars
		option main.cx_forcedirecte
		option main.cx_forceundirec
	endoptions
	stata
END
