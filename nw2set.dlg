VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nw2set")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 338

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nw2set - Declare data to be two-mode network data")
BEGIN
  TEXT tx_vars 20 20 260 ., label("Variables (define the network):")
  VARLIST vl_vars 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 520 244, label("Options")
  TEXT tx_cx_edgelist 20 54 260 ., label("declare data in edgelist format")
  CHECKBOX cx_edgelist 290 54 190 ., label("edgelist") option(edgelist)
  TEXT tx_ed_name 20 82 260 ., label("name of the new network; default =")
  EDIT ed_name 290 82 190 ., nomem option(name)
  TEXT tx_vr_rownames 20 110 260 ., label("names of nodes on level 2")
  VARNAME vr_rownames 290 110 190 ., nomem option(rownames)
  TEXT tx_ed_vars 20 138 260 ., label("Stata variable names to store the network as (one per node, level 1 then level 2")
  EDIT ed_vars 290 138 190 ., nomem option(vars)
  TEXT tx_cx_xvars 20 166 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 290 166 190 ., label("xvars") option(xvars)
  TEXT tx_ed_labs 20 194 260 ., label("new node labels that are used for the network")
  EDIT ed_labs 290 194 190 ., nomem option(labs)
  TEXT tx_cx_clear 20 222 260 ., label("drop all existing networks (but not the Stata dataset) before declaring this one")
  CHECKBOX cx_clear 290 222 190 ., label("clear") option(clear)
  TEXT tx_cx_nwclear 20 250 260 ., label("same as")
  CHECKBOX cx_nwclear 290 250 190 ., label("nwclear") option(nwclear)
END

PROGRAM initialize
BEGIN
END

PROGRAM command
BEGIN
	put "nw2set " main.vl_vars
	beginoptions
		option main.cx_edgelist
		optionarg main.ed_name
		optionarg main.vr_rownames
		optionarg main.ed_vars
		option main.cx_xvars
		optionarg main.ed_labs
		option main.cx_clear
		option main.cx_nwclear
	endoptions
	stata
END
