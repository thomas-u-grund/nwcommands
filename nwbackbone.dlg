VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwbackbone")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 400

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwbackbone - Backbone of a valued network or of a two-mode projection")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network:")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 346, label("Options")
  TEXT tx_method 20 54 260 ., label("Method (required; one-mode: global, disparity, lans, mlf; two-mode: the others)")
  COMBOBOX cb_method 290 54 190 ., dropdown contents(list_method) nomem option(method)
  TEXT tx_alpha 20 82 260 ., label("Significance level alpha (default 0.05)")
  EDIT ed_alpha 290 82 90 ., nomem numonly option(alpha)
  TEXT tx_mtc 20 110 260 ., label("Multiple-testing correction")
  COMBOBOX cb_mtc 290 110 190 ., dropdownlist contents(list_mtc) nomem option(mtc)
  TEXT tx_threshold 20 138 260 ., label("global: keep ties above (one or two numbers)")
  EDIT ed_threshold 290 138 190 ., nomem option(threshold)
  TEXT tx_project 20 166 260 ., label("Two-mode: mode whose projection is filtered")
  COMBOBOX cb_project 290 166 90 ., dropdownlist contents(list_project) nomem option(project)
  TEXT tx_trials 20 194 260 ., label("fdsm: number of random networks (default as R)")
  EDIT ed_trials 290 194 90 ., nomem numonly option(trials)
  TEXT tx_seed 20 222 260 ., label("fdsm: random-number seed")
  EDIT ed_seed 290 222 90 ., nomem numonly option(seed)
  TEXT tx_generate 20 250 260 ., label("Name of the backbone network (default backbone)")
  EDIT ed_generate 290 250 190 ., nomem option(generate)
  CHECKBOX cx_signed 20 282 240 ., label("signed (also keep significantly weak ties as -1)") option(signed)
  CHECKBOX cx_keepvalues 20 308 240 ., label("keepvalues (kept ties keep their values)") option(keepvalues)
  CHECKBOX cx_missing 20 334 240 ., label("missingaszero (also test dyads without a tie)") option(missingaszero)
  CHECKBOX cx_replace 290 282 150 ., label("replace") option(replace)
  CHECKBOX cx_silent 290 308 150 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_method
BEGIN
	disparity
	global
	lans
	mlf
	sdsm
	fdsm
	fixedrow
	fixedcol
	fixedfill
END

LIST list_mtc
BEGIN
	none
	bonferroni
	holm
	hochberg
	hommel
	BH
	BY
	fdr
END

LIST list_project
BEGIN
	1
	2
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwbackbone"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwbackbone " main.cb_net
	beginoptions
		optionarg main.cb_method
		optionarg main.ed_alpha
		optionarg main.cb_mtc
		optionarg main.ed_threshold
		optionarg main.cb_project
		optionarg main.ed_trials
		optionarg main.ed_seed
		optionarg main.ed_generate
		option main.cx_signed
		option main.cx_keepvalues
		option main.cx_missing
		option main.cx_replace
		option main.cx_silent
	endoptions
	stata
END
