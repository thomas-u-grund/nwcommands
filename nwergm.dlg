VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwergm")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1480 738

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwergm - Exponential-family random graph model (ERGM) estimation")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network:")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  TEXT tx_core 20 54 460 ., label("Core (edges is required):")
  CHECKBOX cx_edges 30 76 200 ., label("edges - density/intercept term") option(edges)
  CHECKBOX cx_mutual 30 100 300 ., label("mutual - reciprocated-tie count (directed only)") option(mutual)
  TEXT tx_terms 20 130 300 ., label("Model terms (tick to include; fill in a value if needed):")
  TEXT tx_hdr_0_154 20 154 340 ., label("-- Dyadic covariates --")
  CHECKBOX cx_nodematch 20 176 170 ., label("nodematch")
  VARLIST ed_nodematch 195 176 155 ., nomem
  CHECKBOX cx_nodematchdiff 20 202 170 ., label("nodematchdiff")
  VARLIST ed_nodematchdiff 195 202 155 ., nomem
  CHECKBOX cx_nodecov 20 228 170 ., label("nodecov")
  VARLIST ed_nodecov 195 228 155 ., nomem
  CHECKBOX cx_nodeicov 20 254 170 ., label("nodeicov")
  VARLIST ed_nodeicov 195 254 155 ., nomem
  CHECKBOX cx_nodeocov 20 280 170 ., label("nodeocov")
  VARLIST ed_nodeocov 195 280 155 ., nomem
  CHECKBOX cx_edgecov 20 306 170 ., label("edgecov")
  COMBOBOX ed_edgecov 195 306 155 ., dropdown contents(netlist) nomem
  CHECKBOX cx_absdist 20 332 170 ., label("absdist")
  VARLIST ed_absdist 195 332 155 ., nomem
  CHECKBOX cx_hamming 20 358 170 ., label("hamming")
  COMBOBOX ed_hamming 195 358 155 ., dropdown contents(netlist) nomem
  TEXT tx_hdr_0_384 20 384 340 ., label("-- Factor / mix / sender-receiver --")
  CHECKBOX cx_nodefactor 20 406 170 ., label("nodefactor")
  VARLIST ed_nodefactor 195 406 155 ., nomem
  CHECKBOX cx_nodeofactor 20 432 170 ., label("nodeofactor")
  VARLIST ed_nodeofactor 195 432 155 ., nomem
  CHECKBOX cx_nodeifactor 20 458 170 ., label("nodeifactor")
  VARLIST ed_nodeifactor 195 458 155 ., nomem
  CHECKBOX cx_nodemix 20 484 170 ., label("nodemix")
  VARLIST ed_nodemix 195 484 155 ., nomem
  CHECKBOX cx_sender 20 510 300 ., label("sender: One coefficient per node (except a base node) equal to that node's own") option(sender)
  CHECKBOX cx_receiver 380 154 300 ., label("receiver: One coefficient per node (except a base node) equal to that node's own") option(receiver)
  TEXT tx_hdr_1_180 380 180 340 ., label("-- Geometrically weighted --")
  CHECKBOX cx_gwesp 380 202 170 ., label("gwesp")
  EDIT ed_gwesp 555 202 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwdsp 380 228 170 ., label("gwdsp")
  EDIT ed_gwdsp 555 228 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwnsp 380 254 170 ., label("gwnsp")
  EDIT ed_gwnsp 555 254 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwdegree 380 280 170 ., label("gwdegree")
  EDIT ed_gwdegree 555 280 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwodegree 380 306 170 ., label("gwodegree")
  EDIT ed_gwodegree 555 306 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwidegree 380 332 170 ., label("gwidegree")
  EDIT ed_gwidegree 555 332 155 ., default("0.5") numonly nomem
  TEXT tx_hdr_1_358 380 358 340 ., label("-- Fixed shared-partner counts --")
  CHECKBOX cx_esp 380 380 170 ., label("esp")
  EDIT ed_esp 555 380 155 ., nomem
  CHECKBOX cx_dsp 380 406 170 ., label("dsp")
  EDIT ed_dsp 555 406 155 ., nomem
  TEXT tx_hdr_1_432 380 432 340 ., label("-- Degree sequence --")
  CHECKBOX cx_degree 380 454 170 ., label("degree")
  EDIT ed_degree 555 454 155 ., nomem
  CHECKBOX cx_odegree 380 480 170 ., label("odegree")
  EDIT ed_odegree 555 480 155 ., nomem
  CHECKBOX cx_idegree 380 506 170 ., label("idegree")
  EDIT ed_idegree 555 506 155 ., nomem
  CHECKBOX cx_concurrent 740 154 300 ., label("concurrent: Count of nodes with (total) degree 2 or higher; undirected only") option(concurrent)
  CHECKBOX cx_kstar 740 180 170 ., label("kstar")
  EDIT ed_kstar 915 180 155 ., nomem
  CHECKBOX cx_ostar 740 206 170 ., label("ostar")
  EDIT ed_ostar 915 206 155 ., nomem
  CHECKBOX cx_istar 740 232 170 ., label("istar")
  EDIT ed_istar 915 232 155 ., nomem
  CHECKBOX cx_degrange 740 258 170 ., label("degrange")
  EDIT ed_degrange 915 258 155 ., nomem
  CHECKBOX cx_degrangeto 740 284 170 ., label("degrangeto")
  EDIT ed_degrangeto 915 284 155 ., nomem
  CHECKBOX cx_odegrange 740 310 170 ., label("odegrange")
  EDIT ed_odegrange 915 310 155 ., nomem
  CHECKBOX cx_odegrangeto 740 336 170 ., label("odegrangeto")
  EDIT ed_odegrangeto 915 336 155 ., nomem
  CHECKBOX cx_idegrange 740 362 170 ., label("idegrange")
  EDIT ed_idegrange 915 362 155 ., nomem
  CHECKBOX cx_idegrangeto 740 388 170 ., label("idegrangeto")
  EDIT ed_idegrangeto 915 388 155 ., nomem
  TEXT tx_hdr_2_414 740 414 340 ., label("-- Triad closure (directed) --")
  CHECKBOX cx_triangle 740 436 300 ., label("triangle: Count of triangles (mutually tied triples); undirected only") option(triangle)
  CHECKBOX cx_ctriple 740 462 300 ., label("ctriple: Count of cyclic triples ((i->j),(j->k),(k->i)); directed networks only") option(ctriple)
  CHECKBOX cx_transitiveties 740 488 300 ., label("transitiveties: Count of TIED arcs i->j for which there also exists a two-path i->k->j") option(transitiveties)
  CHECKBOX cx_cyclicalties 740 514 300 ., label("cyclicalties: Count of TIED arcs i->j for which there also exists a return two-path ") option(cyclicalties)
  TEXT tx_hdr_3_154 1100 154 340 ., label("-- Two-mode (bipartite) --")
  CHECKBOX cx_bcov1 1100 176 170 ., label("bcov1")
  VARLIST ed_bcov1 1275 176 155 ., nomem
  CHECKBOX cx_bcov2 1100 202 170 ., label("bcov2")
  VARLIST ed_bcov2 1275 202 155 ., nomem
  CHECKBOX cx_bfactor1 1100 228 170 ., label("bfactor1")
  VARLIST ed_bfactor1 1275 228 155 ., nomem
  CHECKBOX cx_bfactor2 1100 254 170 ., label("bfactor2")
  VARLIST ed_bfactor2 1275 254 155 ., nomem
  CHECKBOX cx_bdegree1 1100 280 170 ., label("bdegree1")
  EDIT ed_bdegree1 1275 280 155 ., nomem
  CHECKBOX cx_bdegree2 1100 306 170 ., label("bdegree2")
  EDIT ed_bdegree2 1275 306 155 ., nomem
  CHECKBOX cx_bstar1 1100 332 170 ., label("bstar1")
  EDIT ed_bstar1 1275 332 155 ., nomem
  CHECKBOX cx_bstar2 1100 358 170 ., label("bstar2")
  EDIT ed_bstar2 1275 358 155 ., nomem
  TEXT tx_hdr_3_384 1100 384 340 ., label("-- Curved (estimated decay) --")
  CHECKBOX cx_gwespfree 1100 406 170 ., label("gwespfree")
  EDIT ed_gwespfree 1275 406 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwdspfree 1100 432 170 ., label("gwdspfree")
  EDIT ed_gwdspfree 1275 432 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwnspfree 1100 458 170 ., label("gwnspfree")
  EDIT ed_gwnspfree 1275 458 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwdegreefree 1100 484 170 ., label("gwdegreefree")
  EDIT ed_gwdegreefree 1275 484 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwodegreefree 1100 510 170 ., label("gwodegreefree")
  EDIT ed_gwodegreefree 1275 510 155 ., default("0.5") numonly nomem
  CHECKBOX cx_gwidegreefree 1100 536 170 ., label("gwidegreefree")
  EDIT ed_gwidegreefree 1275 536 155 ., default("0.5") numonly nomem
  TEXT tx_hdr_3_562 1100 562 340 ., label("-- More bipartite --")
  CHECKBOX cx_bnodematch1 1100 584 170 ., label("bnodematch1")
  VARLIST ed_bnodematch1 1275 584 155 ., nomem
  CHECKBOX cx_bnodematch2 1100 610 170 ., label("bnodematch2")
  VARLIST ed_bnodematch2 1275 610 155 ., nomem
  CHECKBOX cx_bgwdegree1 1100 636 170 ., label("bgwdegree1")
  EDIT ed_bgwdegree1 1275 636 155 ., default("0.5") numonly nomem
  CHECKBOX cx_bgwdegree2 1100 662 170 ., label("bgwdegree2")
  EDIT ed_bgwdegree2 1275 662 155 ., default("0.5") numonly nomem
  TEXT tx_est 20 550 300 ., label("Estimation settings:")
  TEXT tx_lbl_method 20 574 170 ., label("Estimation method; default  unless the m")
  COMBOBOX cb_method 195 574 155 ., dropdownlist contents(list_method) nomem option(method)
  TEXT tx_lbl_mcmcburnin 380 574 170 ., label("MCMC burn-in steps per simulation; defau")
  SPINNER sp_mcmcburnin 555 574 70 ., default(3000) max(999999) min(-999999) nomem option(mcmcburnin)
  TEXT tx_lbl_mcmcinterval 20 600 170 ., label("MCMC steps between recorded draws; defau")
  SPINNER sp_mcmcinterval 195 600 70 ., default(50) max(999999) min(-999999) nomem option(mcmcinterval)
  TEXT tx_lbl_mcmcsamplesize 380 600 170 ., label("Number of recorded MCMC draws per simula")
  SPINNER sp_mcmcsamplesize 555 600 70 ., default(3000) max(999999) min(-999999) nomem option(mcmcsamplesize)
  TEXT tx_lbl_mcmleiterations 20 626 170 ., label("Maximum MCMLE outer iterations; default ")
  SPINNER sp_mcmleiterations 195 626 70 ., default(20) max(999999) min(-999999) nomem option(mcmleiterations)
  TEXT tx_lbl_proposal 380 626 170 ., label("Metropolis-Hastings proposal; default")
  COMBOBOX cb_proposal 555 626 155 ., dropdownlist contents(list_proposal) nomem option(proposal)
  TEXT tx_lbl_seed 20 652 170 ., label("Set the random-number seed before simula")
  SPINNER sp_seed 195 652 70 ., default(-1) max(999999) min(-999999) nomem option(seed)
  TEXT tx_lbl_verbose 380 652 170 ., label("Show MPLE/MCMLE iteration detail")
  CHECKBOX cx_verbose 555 652 120 ., label("verbose") option(verbose)
  TEXT tx_lbl_type 740 574 170 ., label("Directed shared-partner definition (type)")
  COMBOBOX cb_type 915 574 155 ., dropdownlist contents(list_type) nomem option(type)
  CHECKBOX cx_freedyads 740 600 170 ., label("freedyads")
  COMBOBOX ed_freedyads 915 600 155 ., dropdown contents(netlist) nomem
  CHECKBOX cx_blockdiag 740 626 170 ., label("blockdiag")
  VARNAME ed_blockdiag 915 626 155 ., nomem
  CHECKBOX cx_spcache 740 652 170 ., label("spcache") option(spcache)
  CHECKBOX cx_nomcmcsample 915 652 175 ., label("nomcmcsample") option(nomcmcsample)
  CHECKBOX cx_fixdensity 740 678 170 ., label("fixdensity") option(fixdensity)
  CHECKBOX cx_nonative 915 678 175 ., label("nonative") option(nonative)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_method
BEGIN
	mple
	mcmle
END

LIST list_proposal
BEGIN
	uniform
	tnt
END

LIST list_type
BEGIN
	OTP
	ITP
	OSP
	ISP
	RTP
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwergm"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwergm " main.cb_net
	beginoptions
		option main.cx_edges
		option main.cx_mutual
		if main.cx_nodematch {
			require main.ed_nodematch
			put " nodematch(" main.ed_nodematch ")"
		}
		if main.cx_nodematchdiff {
			require main.ed_nodematchdiff
			put " nodematchdiff(" main.ed_nodematchdiff ")"
		}
		if main.cx_nodecov {
			require main.ed_nodecov
			put " nodecov(" main.ed_nodecov ")"
		}
		if main.cx_nodeicov {
			require main.ed_nodeicov
			put " nodeicov(" main.ed_nodeicov ")"
		}
		if main.cx_nodeocov {
			require main.ed_nodeocov
			put " nodeocov(" main.ed_nodeocov ")"
		}
		if main.cx_edgecov {
			require main.ed_edgecov
			put " edgecov(" main.ed_edgecov ")"
		}
		if main.cx_absdist {
			require main.ed_absdist
			put " absdist(" main.ed_absdist ")"
		}
		if main.cx_hamming {
			require main.ed_hamming
			put " hamming(" main.ed_hamming ")"
		}
		if main.cx_nodefactor {
			require main.ed_nodefactor
			put " nodefactor(" main.ed_nodefactor ")"
		}
		if main.cx_nodeofactor {
			require main.ed_nodeofactor
			put " nodeofactor(" main.ed_nodeofactor ")"
		}
		if main.cx_nodeifactor {
			require main.ed_nodeifactor
			put " nodeifactor(" main.ed_nodeifactor ")"
		}
		if main.cx_nodemix {
			require main.ed_nodemix
			put " nodemix(" main.ed_nodemix ")"
		}
		option main.cx_sender
		option main.cx_receiver
		if main.cx_gwesp {
			require main.ed_gwesp
			put " gwesp(" main.ed_gwesp ")"
		}
		if main.cx_gwdsp {
			require main.ed_gwdsp
			put " gwdsp(" main.ed_gwdsp ")"
		}
		if main.cx_gwnsp {
			require main.ed_gwnsp
			put " gwnsp(" main.ed_gwnsp ")"
		}
		if main.cx_gwdegree {
			require main.ed_gwdegree
			put " gwdegree(" main.ed_gwdegree ")"
		}
		if main.cx_gwodegree {
			require main.ed_gwodegree
			put " gwodegree(" main.ed_gwodegree ")"
		}
		if main.cx_gwidegree {
			require main.ed_gwidegree
			put " gwidegree(" main.ed_gwidegree ")"
		}
		if main.cx_esp {
			require main.ed_esp
			put " esp(" main.ed_esp ")"
		}
		if main.cx_dsp {
			require main.ed_dsp
			put " dsp(" main.ed_dsp ")"
		}
		if main.cx_degree {
			require main.ed_degree
			put " degree(" main.ed_degree ")"
		}
		if main.cx_odegree {
			require main.ed_odegree
			put " odegree(" main.ed_odegree ")"
		}
		if main.cx_idegree {
			require main.ed_idegree
			put " idegree(" main.ed_idegree ")"
		}
		if main.cx_gwespfree {
			require main.ed_gwespfree
			put " gwespfree(" main.ed_gwespfree ")"
		}
		if main.cx_gwdspfree {
			require main.ed_gwdspfree
			put " gwdspfree(" main.ed_gwdspfree ")"
		}
		if main.cx_gwnspfree {
			require main.ed_gwnspfree
			put " gwnspfree(" main.ed_gwnspfree ")"
		}
		if main.cx_gwdegreefree {
			require main.ed_gwdegreefree
			put " gwdegreefree(" main.ed_gwdegreefree ")"
		}
		if main.cx_gwodegreefree {
			require main.ed_gwodegreefree
			put " gwodegreefree(" main.ed_gwodegreefree ")"
		}
		if main.cx_gwidegreefree {
			require main.ed_gwidegreefree
			put " gwidegreefree(" main.ed_gwidegreefree ")"
		}
		if main.cx_bcov1 {
			require main.ed_bcov1
			put " bcov1(" main.ed_bcov1 ")"
		}
		if main.cx_bcov2 {
			require main.ed_bcov2
			put " bcov2(" main.ed_bcov2 ")"
		}
		if main.cx_bfactor1 {
			require main.ed_bfactor1
			put " bfactor1(" main.ed_bfactor1 ")"
		}
		if main.cx_bfactor2 {
			require main.ed_bfactor2
			put " bfactor2(" main.ed_bfactor2 ")"
		}
		if main.cx_bdegree1 {
			require main.ed_bdegree1
			put " bdegree1(" main.ed_bdegree1 ")"
		}
		if main.cx_bdegree2 {
			require main.ed_bdegree2
			put " bdegree2(" main.ed_bdegree2 ")"
		}
		if main.cx_bstar1 {
			require main.ed_bstar1
			put " bstar1(" main.ed_bstar1 ")"
		}
		if main.cx_bstar2 {
			require main.ed_bstar2
			put " bstar2(" main.ed_bstar2 ")"
		}
		if main.cx_bnodematch1 {
			require main.ed_bnodematch1
			put " bnodematch1(" main.ed_bnodematch1 ")"
		}
		if main.cx_bnodematch2 {
			require main.ed_bnodematch2
			put " bnodematch2(" main.ed_bnodematch2 ")"
		}
		if main.cx_bgwdegree1 {
			require main.ed_bgwdegree1
			put " bgwdegree1(" main.ed_bgwdegree1 ")"
		}
		if main.cx_bgwdegree2 {
			require main.ed_bgwdegree2
			put " bgwdegree2(" main.ed_bgwdegree2 ")"
		}
		option main.cx_concurrent
		if main.cx_kstar {
			require main.ed_kstar
			put " kstar(" main.ed_kstar ")"
		}
		if main.cx_ostar {
			require main.ed_ostar
			put " ostar(" main.ed_ostar ")"
		}
		if main.cx_istar {
			require main.ed_istar
			put " istar(" main.ed_istar ")"
		}
		if main.cx_degrange {
			require main.ed_degrange
			put " degrange(" main.ed_degrange ")"
		}
		if main.cx_degrangeto {
			require main.ed_degrangeto
			put " degrangeto(" main.ed_degrangeto ")"
		}
		if main.cx_odegrange {
			require main.ed_odegrange
			put " odegrange(" main.ed_odegrange ")"
		}
		if main.cx_odegrangeto {
			require main.ed_odegrangeto
			put " odegrangeto(" main.ed_odegrangeto ")"
		}
		if main.cx_idegrange {
			require main.ed_idegrange
			put " idegrange(" main.ed_idegrange ")"
		}
		if main.cx_idegrangeto {
			require main.ed_idegrangeto
			put " idegrangeto(" main.ed_idegrangeto ")"
		}
		option main.cx_triangle
		option main.cx_ctriple
		option main.cx_transitiveties
		option main.cx_cyclicalties
		optionarg main.cb_method
		optionarg main.sp_mcmcburnin
		optionarg main.sp_mcmcinterval
		optionarg main.sp_mcmcsamplesize
		optionarg main.sp_mcmleiterations
		optionarg main.cb_proposal
		optionarg main.sp_seed
		option main.cx_verbose
		optionarg main.cb_type
		if main.cx_freedyads {
			require main.ed_freedyads
			put " freedyads(" main.ed_freedyads ")"
		}
		if main.cx_blockdiag {
			require main.ed_blockdiag
			put " blockdiag(" main.ed_blockdiag ")"
		}
		option main.cx_spcache
		option main.cx_nomcmcsample
		option main.cx_fixdensity
		option main.cx_nonative
	endoptions
	stata
END
