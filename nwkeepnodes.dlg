VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwkeepnodes")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwkeepnodes - Keep nodes of a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_ed_nodes 20 54 260 ., label("of  to be kept")
  EDIT ed_nodes 290 54 190 ., nomem option(nodes)
  TEXT tx_ed_generate 20 82 260 ., label("Generates a new network and does not overwrite the original network")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_ed_attributes 20 110 260 ., label("Attribute variables that are included in the drop")
  EDIT ed_attributes 290 110 190 ., nomem option(attributes)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwkeepnodes"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwkeepnodes " main.cb_net
	beginoptions
		optionarg main.ed_nodes
		optionarg main.ed_generate
		optionarg main.ed_attributes
	endoptions
	stata
END
