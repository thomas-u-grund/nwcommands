VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwreplacemat")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwreplacemat - Replace network with Stata or Mata matrix")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_ed_newmat 20 54 260 ., label("name of a Stata or Mata matrix")
  EDIT ed_newmat 290 54 190 ., nomem option(newmat)
  TEXT tx_ed_vars 20 82 260 ., label("Stata variable names to use when  requires resizing the network; default = auto-")
  EDIT ed_vars 290 82 190 ., nomem option(vars)
  TEXT tx_ed_labs 20 110 260 ., label("new node labels to use when  requires resizing the network; default = , , ...")
  EDIT ed_labs 290 110 190 ., nomem option(labs)
  TEXT tx_cx_nosync 20 138 260 ., label("do not sync Stata variables; by default Stata variables are synced (see )")
  CHECKBOX cx_nosync 290 138 190 ., label("nosync") option(nosync)
  TEXT tx_cx_netonly 20 166 260 ., label("only update the network, do not touch the Stata dataset at all")
  CHECKBOX cx_netonly 290 166 190 ., label("netonly") option(netonly)
  TEXT tx_cx_xvars 20 194 260 ., label("also load the updated network as Stata variables (see )")
  CHECKBOX cx_xvars 290 194 190 ., label("xvars") option(xvars)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwreplacemat"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_newmat
	put "nwreplacemat " main.cb_net
	beginoptions
		optionarg main.ed_newmat
		optionarg main.ed_vars
		optionarg main.ed_labs
		option main.cx_nosync
		option main.cx_netonly
		option main.cx_xvars
	endoptions
	stata
END
