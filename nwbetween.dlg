VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwbetween")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 422

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwbetween - Calculate betweenness centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 328, label("Options")
  TEXT tx_cx_replace 20 54 260 ., label("Allow overwriting an existing variable")
  CHECKBOX cx_replace 290 54 190 ., label("replace") option(replace)
  TEXT tx_ed_generate 20 82 260 ., label("Required. Variable for betweenness centrality")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_cx_sym 20 110 260 ., label("Symmetrize first (larger of the two tie values)")
  CHECKBOX cx_sym 290 110 190 ., label("sym") option(symmetrize)
  TEXT tx_cx_standardize 20 138 260 ., label("standardize centrality scores")
  CHECKBOX cx_standardize 290 138 190 ., label("standardize") option(standardize)
  TEXT tx_cx_silent 20 166 260 ., label("Suppress summary table of generated variable")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
  TEXT tx_cx_weighted 20 194 260 ., label("Weighted shortest paths (use tie values)")
  CHECKBOX cx_weighted 290 194 190 ., label("weighted") option(weighted)
  TEXT tx_ed_alpha 20 222 260 ., label("Exponent alpha for weighted; default = 1")
  EDIT ed_alpha 290 222 100 ., numonly nomem option(alpha)
  TEXT tx_cx_force 20 250 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 250 190 ., label("force") option(force)
  TEXT tx_cx_binary 20 278 260 ., label("Ignore tie values (default: use them)")
  CHECKBOX cx_binary 290 278 190 ., label("binary") option(binary)
  TEXT tx_cx_twomode 20 306 260 ., label("Two-mode: Borgatti-Everett scaling (default)")
  CHECKBOX cx_twomode 290 306 190 ., label("twomode") option(twomode)
  TEXT tx_cx_onemode 20 334 260 ., label("Two-mode: betweenness of one-mode graph")
  CHECKBOX cx_onemode 290 334 190 ., label("onemode") option(onemode)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwbetween"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.ed_alpha.isneq("") & !main.ed_alpha.isnumlist() {
		stopbox stop "Weight-to-distance exponent used with weighted: enter a number (or numbers)."
	}
	require main.ed_generate
	put "nwbetween " main.cb_net
	beginoptions
		option main.cx_replace
		optionarg main.ed_generate
		option main.cx_sym
		option main.cx_standardize
		option main.cx_silent
		option main.cx_weighted
		optionarg main.ed_alpha
		option main.cx_force
		option main.cx_binary
		option main.cx_twomode
		option main.cx_onemode
	endoptions
	stata
END
