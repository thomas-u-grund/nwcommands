VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwbetween")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 394

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwbetween - Calculate betweenness centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 300, label("Options")
  TEXT tx_cx_replace 20 54 260 ., label("allow overwriting an existing variable of the same name")
  CHECKBOX cx_replace 290 54 190 ., label("replace") option(replace)
  TEXT tx_ed_generate 20 82 260 ., label("Required. Variable name for betweenness centrality")
  EDIT ed_generate 290 82 190 ., nomem option(generate)
  TEXT tx_cx_nosym 20 110 260 ., label("do not symmetrize network before calculation of shortest paths")
  CHECKBOX cx_nosym 290 110 190 ., label("nosym") option(nosym)
  TEXT tx_cx_standardize 20 138 260 ., label("standardize centrality scores")
  CHECKBOX cx_standardize 290 138 190 ., label("standardize") option(standardize)
  TEXT tx_cx_silent 20 166 260 ., label("suppress the summary table of the generated variable")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
  TEXT tx_cx_weighted 20 194 260 ., label("calculate on weighted (Dijkstra) shortest paths instead of dichotomizing")
  CHECKBOX cx_weighted 290 194 190 ., label("weighted") option(weighted)
  TEXT tx_ed_alpha 20 222 260 ., label("weight-to-distance exponent used with ; default = 1")
  EDIT ed_alpha 290 222 100 ., numonly nomem option(alpha)
  TEXT tx_cx_force 20 250 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 250 190 ., label("force") option(force)
  TEXT tx_cx_binary 20 278 260 ., label("Ignore the tie values of a valued network (default: use them)")
  CHECKBOX cx_binary 290 278 190 ., label("binary") option(binary)
  TEXT tx_cx_twomode 20 306 260 ., label("Two-mode network: standardise as Borgatti and Everett (1997)")
  CHECKBOX cx_twomode 290 306 190 ., label("twomode") option(twomode)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwbetween"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwbetween " main.cb_net
	beginoptions
		option main.cx_replace
		optionarg main.ed_generate
		option main.cx_nosym
		option main.cx_standardize
		option main.cx_silent
		option main.cx_weighted
		optionarg main.ed_alpha
		option main.cx_force
		option main.cx_binary
		option main.cx_twomode
	endoptions
	stata
END
