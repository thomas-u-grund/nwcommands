VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwreach")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwreach - Calculate reachability network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_ed_name 20 54 260 ., label("Name of the new network; default =")
  EDIT ed_name 290 54 190 ., nomem option(name)
  TEXT tx_cx_xvars 20 82 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 82 190 ., label("xvars") option(xvars)
  TEXT tx_cx_sym 20 110 260 ., label("Symmetrize network before calculation of reachability")
  CHECKBOX cx_sym 290 110 190 ., label("sym") option(sym)
  TEXT tx_cx_nwreplace 20 138 260 ., label("if a network named  already exists, drop it and use this name anyway - required,")
  CHECKBOX cx_nwreplace 290 138 190 ., label("nwreplace") option(nwreplace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwreach"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwreach " main.cb_net
	beginoptions
		optionarg main.ed_name
		option main.cx_xvars
		option main.cx_sym
		option main.cx_nwreplace
	endoptions
	stata
END
