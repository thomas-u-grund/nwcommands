VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwpath")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 310

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwpath - Calculate paths between nodes")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_cx_nwreplace 20 54 260 ., label("Overwrite networks with")
  CHECKBOX cx_nwreplace 290 54 190 ., label("nwreplace") option(nwreplace)
  TEXT tx_ed_ego 20 82 260 ., label("Name of start node")
  EDIT ed_ego 290 82 190 ., nomem option(ego)
  TEXT tx_ed_alter 20 110 260 ., label("Name of destination node")
  EDIT ed_alter 290 110 190 ., nomem option(alter)
  TEXT tx_sp_egoid 20 138 260 ., label("Nodeid of start node")
  SPINNER sp_egoid 290 138 70 ., default(0) max(999999) min(-999999) nomem option(egoid)
  TEXT tx_sp_alterid 20 166 260 ., label("Nodeid of destination node")
  SPINNER sp_alterid 290 166 70 ., default(0) max(999999) min(-999999) nomem option(alterid)
  TEXT tx_cx_sym 20 194 260 ., label("Symmetrize network for calculation")
  CHECKBOX cx_sym 290 194 190 ., label("sym") option(sym)
  TEXT tx_cb_generate 20 222 260 ., label("Save paths as networks beginning with")
  COMBOBOX cb_generate 290 222 190 ., dropdown contents(netlist) nomem option(generate)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwpath"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwpath " main.cb_net
	beginoptions
		option main.cx_nwreplace
		optionarg main.ed_ego
		optionarg main.ed_alter
		optionarg main.sp_egoid
		optionarg main.sp_alterid
		option main.cx_sym
		optionarg main.cb_generate
	endoptions
	stata
END
