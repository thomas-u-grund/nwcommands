VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcug")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 310

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcug - Conditional Uniform Graph (CUG) test")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_ed_stat 20 54 260 ., label("Command template used to compute the test statistic; must contain the literal to")
  EDIT ed_stat 290 54 190 ., nomem option(stat)
  TEXT tx_ed_rname 20 82 260 ., label("Name of the 's  scalar to use as the test statistic")
  EDIT ed_rname 290 82 190 ., nomem option(rname)
  TEXT tx_sp_reps 20 110 260 ., label("Number of conditioned random networks to draw; default = 1000")
  SPINNER sp_reps 290 110 70 ., default(1000) max(999999) min(-999999) nomem option(reps)
  TEXT tx_sp_seed 20 138 260 ., label("Set the random-number seed before drawing (for reproducibility)")
  SPINNER sp_seed 290 138 70 ., default(-1) max(999999) min(-999999) nomem option(seed)
  TEXT tx_ed_tail 20 166 260 ., label("Which tail(s) to report a p-value for; default =")
  EDIT ed_tail 290 166 190 ., nomem option(tail)
  TEXT tx_ed_condition 20 194 260 ., label("Null model to condition random draws on; default =")
  EDIT ed_condition 290 194 190 ., nomem option(condition)
  TEXT tx_cx_silent 20 222 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 222 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcug"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_stat
	require main.ed_rname
	put "nwcug " main.cb_net
	beginoptions
		optionarg main.ed_stat
		optionarg main.ed_rname
		optionarg main.sp_reps
		optionarg main.sp_seed
		optionarg main.ed_tail
		optionarg main.ed_condition
		option main.cx_silent
	endoptions
	stata
END
