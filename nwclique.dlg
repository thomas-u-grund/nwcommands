VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwclique")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwclique - Maximal clique enumeration")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Required. Variable for largest clique size per node")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_sp_minsize 20 110 260 ., label("Smallest clique size to report; default = 3")
  SPINNER sp_minsize 290 110 70 ., default(3) max(999999) min(1) nomem option(minsize)
  TEXT tx_cx_silent 20 138 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 138 190 ., label("silent") option(silent)
  TEXT tx_cx_nomatrix 20 166 260 ., label("Do not store the clique matrix (faster)")
  CHECKBOX cx_nomatrix 290 166 190 ., label("nomatrix") option(nomatrix)
  TEXT tx_cx_sym 20 194 260 ., label("Directed: analyse symmetrized (default: refused)")
  CHECKBOX cx_sym 290 194 190 ., label("sym") option(symmetrize)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwclique"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_generate
	put "nwclique " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		optionarg main.sp_minsize
		option main.cx_silent
		option main.cx_nomatrix
		option main.cx_sym
	endoptions
	stata
END
