VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwpermute")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwpermute - Generate permutation of a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_cx_xvars 20 54 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 54 190 ., label("xvars") option(xvars)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing network with permutation")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_ed_generate 20 110 260 ., label("Save permutation as new network")
  EDIT ed_generate 290 110 190 ., nomem option(generate)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwpermute"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwpermute " main.cb_net
	beginoptions
		option main.cx_xvars
		option main.cx_replace
		optionarg main.ed_generate
	endoptions
	stata
END
