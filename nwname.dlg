VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwname")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 520 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwname - Rename a network or change its meta-information")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network:")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 480 86, label("Details")
  TEXT tx_ed_new 20 54 260 ., label("New network name:")
  EDIT ed_new 290 54 190 ., nomem
  TEXT tx_ed_free 20 82 260 ., label("Additional options (typed as on the command line):")
  EDIT ed_free 290 82 190 ., nomem
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwname"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwname " main.cb_net
	if main.ed_new.isneq("") {
		put ", " main.ed_new
	}
	if main.ed_free.isneq("") {
		put " " main.ed_free
	}
	stata
END
