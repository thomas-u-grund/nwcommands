VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwds")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwds - List loaded networks, in the style of Stata's own")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_cx_alpha 20 54 260 ., label("List network names in alphabetical order (the default is creation order)")
  CHECKBOX cx_alpha 290 54 190 ., label("alpha") option(alpha)
  TEXT tx_cx_not 20 82 260 ., label("Invert the selection - list every  loaded network instead of the ones")
  CHECKBOX cx_not 290 82 190 ., label("not") option(not)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwds"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwds " main.cb_net
	beginoptions
		option main.cx_alpha
		option main.cx_not
	endoptions
	stata
END
