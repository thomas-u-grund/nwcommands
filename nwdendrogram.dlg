VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdendrogram")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdendrogram - Plot a wheel dendrogram")
BEGIN
  TEXT tx_net 20 20 260 ., label("Cluster name (nwhierarchy; blank = latest):")
  COMBOBOX cb_cluster 290 20 190 ., dropdown contents(clusterlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_ed_factor 20 54 260 ., label("zoom in or out")
  EDIT ed_factor 290 54 190 ., nomem option(factor)
  TEXT tx_vr_label 20 82 260 ., label("label observations")
  VARNAME vr_label 290 82 190 ., nomem option(label)
  TEXT tx_cx_lab 20 110 260 ., label("Use the node labels saved with the network")
  CHECKBOX cx_lab 290 110 190 ., label("lab") option(lab)
  TEXT tx_name 20 138 260 ., label("Graph name in memory; default = dendrogram")
  EDIT ed_name 290 138 190 ., nomem option(name)
  TEXT tx_saving 20 166 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 166 190 ., save nomem option(saving)
  TEXT tx_export 20 194 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 194 190 ., save nomem option(export)
END

LIST clusterlist
BEGIN
	// populated at runtime by _nwdialog_clusters.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog_clusters nwdendrogram"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdendrogram " main.cb_cluster
	beginoptions
		optionarg main.ed_factor
		optionarg main.vr_label
		option main.cx_lab
		optionarg main.ed_name
		optionarg main.fi_saving
		optionarg main.fi_export
	endoptions
	stata
END
