VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdendrogram")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdendrogram - Plot a wheel dendrogram")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_ed_factor 20 54 260 ., label("zoom in or out")
  EDIT ed_factor 290 54 190 ., nomem option(factor)
  TEXT tx_vr_label 20 82 260 ., label("label observations")
  VARNAME vr_label 290 82 190 ., nomem option(label)
  TEXT tx_cx_lab 20 110 260 ., label("display node labels saved with the network (), the same convention  and  use; ta")
  CHECKBOX cx_lab 290 110 190 ., label("lab") option(lab)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdendrogram"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdendrogram " main.cb_net
	beginoptions
		optionarg main.ed_factor
		optionarg main.vr_label
		option main.cx_lab
	endoptions
	stata
END
