VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsave")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsave - Save network data in file")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_cx_old 20 54 260 ., label("save in a Stata-version-backward-compatible format (uses  internally instead of ")
  CHECKBOX cx_old 290 54 190 ., label("old") option(old)
  TEXT tx_cx_replace 20 82 260 ., label("overwrite existing dataset")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsave"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsave " main.cb_net
	beginoptions
		option main.cx_old
		option main.cx_replace
	endoptions
	stata
END
