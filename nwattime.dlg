VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwattime")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwattime - Static graph view of a temporal network at a given time")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_ed_at 20 54 260 ., label("The timepoint to slice at")
  EDIT ed_at 290 54 100 ., numonly nomem option(at)
  TEXT tx_ed_name 20 82 260 ., label("Name of the new static network; default =")
  EDIT ed_name 290 82 190 ., nomem option(name)
  TEXT tx_cx_xvars 20 110 260 ., label("Generate Stata variables for the new network")
  CHECKBOX cx_xvars 290 110 190 ., label("xvars") option(xvars)
  TEXT tx_cx_replace 20 138 260 ., label("Replace an existing network of the same name")
  CHECKBOX cx_replace 290 138 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwattime"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_at
	put "nwattime " main.cb_net
	beginoptions
		optionarg main.ed_at
		optionarg main.ed_name
		option main.cx_xvars
		option main.cx_replace
	endoptions
	stata
END
