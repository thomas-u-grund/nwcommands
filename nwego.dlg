VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwego")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwego - Ego-network size and density")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_ed_sizevar 20 54 260 ., label("Name of the Stata variable that stores ego-network size; default =")
  EDIT ed_sizevar 290 54 190 ., nomem option(sizevar)
  TEXT tx_ed_densvar 20 82 260 ., label("Name of the Stata variable that stores ego-network density; default =")
  EDIT ed_densvar 290 82 190 ., nomem option(densvar)
  TEXT tx_cx_replace 20 110 260 ., label("Replace existing variables")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
  TEXT tx_cx_silent 20 138 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 138 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwego"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwego " main.cb_net
	beginoptions
		optionarg main.ed_sizevar
		optionarg main.ed_densvar
		option main.cx_replace
		option main.cx_silent
	endoptions
	stata
END
