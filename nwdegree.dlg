VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdegree")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 590

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdegree - Degree centrality and distribution")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 496, label("Options")
  TEXT tx_cx_replace 20 54 260 ., label("Overwrite existing variables")
  CHECKBOX cx_replace 290 54 190 ., label("replace") option(replace)
  TEXT tx_cx_standardize 20 82 260 ., label("Divide degree or strength by N - 1")
  CHECKBOX cx_standardize 290 82 190 ., label("standardize") option(standardize)
  TEXT tx_cx_silent 20 110 260 ., label("Suppress output")
  CHECKBOX cx_silent 290 110 190 ., label("silent") option(silent)
  TEXT tx_cx_isolates 20 138 260 ., label("Generate variable for network isolates")
  CHECKBOX cx_isolates 290 138 190 ., label("isolates") option(isolates)
  TEXT tx_ed_alpha 20 166 260 ., label("alpha, valued networks (1 = strength, 0 = ties)")
  EDIT ed_alpha 290 166 100 ., numonly nomem option(alpha)
  TEXT tx_vl_generate 20 194 260 ., label("Required. Names: degree or out/in (+ isolates)")
  VARLIST vl_generate 290 194 190 ., nomem option(generate)
  TEXT tx_ed_in 20 222 260 ., label("Options for tabulating indegree")
  EDIT ed_in 290 222 190 ., nomem option(in)
  TEXT tx_ed_out 20 250 260 ., label("Options for tabulating outdegree")
  EDIT ed_out 290 250 190 ., nomem option(out)
  TEXT tx_cx_binary 20 278 260 ., label("Ignore tie values of a valued network")
  CHECKBOX cx_binary 290 278 190 ., label("binary") option(binary)
  TEXT tx_ed_ties 20 306 260 ., label("Valued: variables for the number of ties")
  EDIT ed_ties 290 306 190 ., nomem option(ties)
  TEXT tx_cx_onemode 20 334 260 ., label("Two-mode: degree of the one-mode graph")
  CHECKBOX cx_onemode 290 334 190 ., label("onemode") option(onemode)
  TEXT tx_cx_raw 20 362 260 ., label("Two-mode: raw degree (not normalised)")
  CHECKBOX cx_raw 290 362 190 ., label("raw") option(raw)
  TEXT tx_plot 20 390 260 ., label("Histogram of degrees (one network, one-mode)")
  CHECKBOX cx_plot 290 390 190 ., label("plot") option(plot)
  TEXT tx_ccdf 20 418 260 ., label("plot: CCDF on log-log axes")
  CHECKBOX cx_ccdf 290 418 190 ., label("ccdf") option(ccdf)
  TEXT tx_gname 20 446 260 ., label("name for the graph created by plot; default = degree")
  EDIT ed_gname 290 446 190 ., nomem option(name)
  TEXT tx_saving 20 474 260 ., label("Save the graph to a file (.gph)")
  FILE fi_saving 290 474 190 ., save nomem option(saving)
  TEXT tx_export 20 502 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 502 190 ., save nomem option(export)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdegree"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.ed_alpha.isneq("") & !main.ed_alpha.isnumlist() {
		stopbox stop "alpha: enter a number."
	}
	require main.vl_generate
	put "nwdegree " main.cb_net
	beginoptions
		option main.cx_replace
		option main.cx_standardize
		option main.cx_silent
		option main.cx_isolates
		optionarg main.ed_alpha
		optionarg main.vl_generate
		optionarg main.ed_in
		optionarg main.ed_out
		option main.cx_binary
		optionarg main.ed_ties
		option main.cx_onemode
		option main.cx_raw
		option main.cx_plot
		option main.cx_ccdf
		optionarg main.ed_gname
		optionarg main.fi_saving
		optionarg main.fi_export
	endoptions
	stata
END
