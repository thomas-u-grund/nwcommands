VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdegree")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 478

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdegree - Degree centrality and distribution")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 384, label("Options")
  TEXT tx_cx_replace 20 54 260 ., label("Overwrite existing variables")
  CHECKBOX cx_replace 290 54 190 ., label("replace") option(replace)
  TEXT tx_cx_standardize 20 82 260 ., label("Divide degree or strength by N - 1")
  CHECKBOX cx_standardize 290 82 190 ., label("standardize") option(standardize)
  TEXT tx_cx_silent 20 110 260 ., label("Surpress output")
  CHECKBOX cx_silent 290 110 190 ., label("silent") option(silent)
  TEXT tx_cx_isolates 20 138 260 ., label("Generate variable for network isolates")
  CHECKBOX cx_isolates 290 138 190 ., label("isolates") option(isolates)
  TEXT tx_ed_alpha 20 166 260 ., label("Tuning parameter for valued networks; default = 1 (strength), 0 = number of ties")
  EDIT ed_alpha 290 166 100 ., numonly nomem option(alpha)
  TEXT tx_vl_generate 20 194 260 ., label("Generate variables for degree, outdegree, indegree, isolate")
  VARLIST vl_generate 290 194 190 ., nomem option(generate)
  TEXT tx_ed_in 20 222 260 ., label("Options for tabulating")
  EDIT ed_in 290 222 190 ., nomem option(in)
  TEXT tx_cx_outputoff 20 250 260 ., label("Reserved/internal - has no effect on a one-mode network's own output; use silent instead")
  CHECKBOX cx_outputoff 290 250 190 ., label("outputoff") option(outputoff)
  TEXT tx_ed_out 20 278 260 ., label("Options for tabulating")
  EDIT ed_out 290 278 190 ., nomem option(out)
  TEXT tx_cx_binary 20 306 260 ., label("Ignore the tie values of a valued network (default: use them)")
  CHECKBOX cx_binary 290 306 190 ., label("binary") option(binary)
  TEXT tx_ed_ties 20 334 260 ., label("Variables for the number of ties (valued network): one name, or outdegree and indegree")
  EDIT ed_ties 290 334 190 ., nomem option(ties)
  TEXT tx_cx_onemode 20 362 260 ., label("Two-mode network: one-mode degree of the bipartite graph (default: two-mode degree)")
  CHECKBOX cx_onemode 290 362 190 ., label("onemode") option(onemode)
  TEXT tx_cx_raw 20 390 260 ., label("Two-mode network: raw degree, not divided by the size of the other mode")
  CHECKBOX cx_raw 290 390 190 ., label("raw") option(raw)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdegree"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdegree " main.cb_net
	beginoptions
		option main.cx_replace
		option main.cx_standardize
		option main.cx_silent
		option main.cx_isolates
		optionarg main.ed_alpha
		optionarg main.vl_generate
		optionarg main.ed_in
		option main.cx_outputoff
		optionarg main.ed_out
		option main.cx_binary
		optionarg main.ed_ties
		option main.cx_onemode
		option main.cx_raw
	endoptions
	stata
END
