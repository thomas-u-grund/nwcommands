VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwvalidvars")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 142

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwvalidvars - Validate Stata variables for network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Number of nodes:")
  EDIT cb_net 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 520 48, label("Options")
  TEXT tx_ed_stub 20 54 260 ., label("Stem of the new variable names")
  EDIT ed_stub 290 54 190 ., nomem option(stub)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwvalidvars"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.cb_net.isneq("") & !main.cb_net.isNumlistGT(0) {
		stopbox stop "Number of nodes: enter a whole number greater than 0."
	}
	require main.cb_net
	require main.ed_stub
	put "nwvalidvars " main.cb_net
	beginoptions
		optionarg main.ed_stub
	endoptions
	stata
END
