* ---- (2) MPLE ----
capture program drop ns_mple
program ns_mple
	args id net dir terms edges
	qui nwclear
	qui clear
	qui nwset, mat(M_`net') `=cond(`dir',"directed","undirected")' name(g)
	qui svmat NA_`net', names(col)
	qui nwergm g, `edges' structural(`terms') method(mple)
	matrix b = e(b)
	matrix V = e(V)
end
capture program drop ns_cmp
program ns_cmp
	args id j coef se
	if abs(b[1,`j'] - `coef') > 1e-4 * max(1, abs(`coef')) {
		di as err "FAIL MPLE `id': coefficient `j' is " b[1,`j'] " but R gives `coef'"
		exit 9
	}
	if abs(sqrt(V[`j',`j']) - `se') > 2e-3 * max(1, `se') {
		di as err "FAIL MPLE `id': SE `j' is " sqrt(V[`j',`j']) " but R gives `se'"
		exit 9
	}
end
