capture adopath ++ "lib"
do unw_ergm.do

* Certifies the structural ergm terms of nwergm's structural() option (non-bipartite):
*  (1) observed statistic == R ergm 4.12.0 summary() on a small undirected and a small directed network,
*  (2) MPLE coefficients and standard errors == R ergm(estimate="MPLE") on a 60-node and a 40-node network,
*  (3) native change statistics == brute-force differences of the observed statistic (random graphs),
*  (4) MCMLE / simulate / error smoke tests.
* Reference values were produced by dev/E3/gen_test_structural.R (this file is generated by it).
capture adopath ++ "lib/plugins/macos"
capture adopath ++ "lib/plugins/unix"
capture adopath ++ "lib/plugins/windows"

mata:
mata set matastrict off
void ns_t_fill(class ErgmGraph G, real matrix A, real scalar dir){
	real scalar i, j, n
	n = rows(A)
	G.init(n, dir)
	for (i=1; i<=n; i++) for (j=1; j<=n; j++) {
		if (i == j) continue
		if (!dir & j < i) continue
		if (A[i,j] != 0) G.toggle(i,j)
	}
}
end

capture program drop ns_stat
program ns_stat
	args net dir terms
	mata: __nwergm_last_M = ErgmModel()
	mata: __nwergm_last_M.init()
	mata: __nwergm_last_G = ErgmGraph()
	mata: ns_t_fill(__nwergm_last_G, st_matrix("A_`net'"), `dir')
	qui _nwergm_struct `net', terms(`terms') nodes(`=rowsof(A_`net')') directed(`=cond(`dir',"true","false")')
	mata: st_matrix("__ns_S", __nwergm_last_M.full_statistic(__nwergm_last_G))
end

capture program drop ns_check
program ns_check
	args id net dir terms expected
	ns_stat `net' `dir' "`terms'"
	local k : word count `expected'
	assert colsof(__ns_S) == `k'
	forvalues j = 1/`k' {
		local e : word `j' of `expected'
		if abs(__ns_S[1,`j'] - `e') > 1e-6 {
			di as err "FAIL statistic `id' on `net': coefficient `j' is " __ns_S[1,`j'] " but R gives `e'"
			exit 9
		}
	}
end

