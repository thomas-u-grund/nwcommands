VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcloseness")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcloseness - Calculate closeness centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_vr_generate 20 54 260 ., label("variables names to save closeness, farness and nearness scores; default:")
  VARNAME vr_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_nosym 20 82 260 ., label("do not symmetrize network before calculation of shortest paths")
  CHECKBOX cx_nosym 290 82 190 ., label("nosym") option(nosym)
  TEXT tx_cx_replace 20 110 260 ., label("overwrite existing  (or ); required if they already exist")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcloseness"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwcloseness " main.cb_net
	beginoptions
		optionarg main.vr_generate
		option main.cx_nosym
		option main.cx_replace
	endoptions
	stata
END
