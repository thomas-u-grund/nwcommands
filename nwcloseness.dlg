VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcloseness")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 256

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcloseness - Calculate closeness centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 190, label("Options")
  TEXT tx_vr_generate 20 54 260 ., label("variables names to save closeness, farness and nearness scores; default:")
  VARNAME vr_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_nosym 20 82 260 ., label("do not symmetrize network before calculation of shortest paths")
  CHECKBOX cx_nosym 290 82 190 ., label("nosym") option(nosym)
  TEXT tx_cx_replace 20 110 260 ., label("Overwrite existing var1, var2, var3 (or _closeness, _farness, _nearness); required if they already exist")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
  TEXT tx_cx_force 20 138 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 138 190 ., label("force") option(force)
  TEXT tx_cx_silent 20 166 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
  TEXT tx_cx_legacy 20 194 260 ., label("On an unconnected network use (nodes - 1) / farness as in earlier releases")
  CHECKBOX cx_legacy 290 194 190 ., label("legacy") option(legacy)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcloseness"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwcloseness " main.cb_net
	beginoptions
		optionarg main.vr_generate
		option main.cx_nosym
		option main.cx_replace
		option main.cx_force
		option main.cx_silent
		option main.cx_legacy
	endoptions
	stata
END
