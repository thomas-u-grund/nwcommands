VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwset")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 506

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwset - Declare data to be network data")
BEGIN
  TEXT tx_vars 20 20 260 ., label("Variables (define the network):")
  VARLIST vl_vars 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 1030 412, label("Options")
  TEXT tx_cx_valued 20 54 260 ., label("Treat the network as valued (tie strength)")
  CHECKBOX cx_valued 290 54 190 ., label("valued") option(valued)
  TEXT tx_cx_unvalued 20 82 260 ., label("Force network to be unvalued (binary)")
  CHECKBOX cx_unvalued 290 82 190 ., label("unvalued") option(unvalued)
  TEXT tx_ed_nodenames 20 110 260 ., label("Node IDs (Mata string or numeric vector)")
  EDIT ed_nodenames 290 110 190 ., nomem option(nodenames)
  TEXT tx_cx_overwrite 20 138 260 ., label("Backward-compatible alias for replace")
  CHECKBOX cx_overwrite 290 138 190 ., label("overwrite") option(overwrite)
  TEXT tx_cx_replace 20 166 260 ., label("Overwrite existing network of the same name")
  CHECKBOX cx_replace 290 166 190 ., label("replace") option(replace)
  TEXT tx_cx_bipartite 20 194 260 ., label("Two-mode network from matrix/affiliation data")
  CHECKBOX cx_bipartite 290 194 190 ., label("bipartite") option(bipartite)
  TEXT tx_cx_twomode 20 222 260 ., label("Two-mode network from an edgelist")
  CHECKBOX cx_twomode 290 222 190 ., label("twomode") option(twomode)
  TEXT tx_vr_biprownames 20 250 260 ., label("Bipartite: variable with mode-1 node names")
  VARNAME vr_biprownames 290 250 190 ., nomem option(biprownames)
  TEXT tx_cx_selfloop 20 278 260 ., label("Allow self-loops (default: diagonal is blanked)")
  CHECKBOX cx_selfloop 290 278 190 ., label("selfloop") option(selfloop)
  TEXT tx_ed_labs 20 306 260 ., label("Node labels")
  EDIT ed_labs 290 306 190 ., nomem option(labs)
  TEXT tx_ed_vars 20 334 260 ., label("Variables holding the node identifiers")
  EDIT ed_vars 290 334 190 ., nomem option(vars)
  TEXT tx_cx_keeporiginal 20 362 260 ., label("Edgelist: keep original IDs in _nodeoriginal")
  CHECKBOX cx_keeporiginal 290 362 190 ., label("keeporiginal") option(keeporiginal)
  TEXT tx_cx_xvars 20 390 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 390 190 ., label("xvars") option(xvars)
  TEXT tx_cx_clear 20 418 260 ., label("Clear all networks (but keep Stata variables)")
  CHECKBOX cx_clear 290 418 190 ., label("clear") option(clear)
  TEXT tx_cx_nwclear 530 54 260 ., label("Same as clear")
  CHECKBOX cx_nwclear 800 54 190 ., label("nwclear") option(nwclear)
  TEXT tx_cx_nooutput 530 82 260 ., label("Suppress the summary display")
  CHECKBOX cx_nooutput 800 82 190 ., label("nooutput") option(nooutput)
  TEXT tx_cx_edgelist 530 110 260 ., label("Declare data in edgelist format")
  CHECKBOX cx_edgelist 800 110 190 ., label("edgelist") option(edgelist)
  TEXT tx_cb_name 530 138 260 ., label("Name of the new network; default = network")
  COMBOBOX cb_name 800 138 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_vr_labsfromvar 530 166 260 ., label("Use information in varname as node labels")
  VARNAME vr_labsfromvar 800 166 190 ., nomem option(labsfromvar)
  TEXT tx_ed_edgelabs 530 194 260 ., label("Edgelist: labels for the ID variables")
  EDIT ed_edgelabs 800 194 190 ., nomem option(edgelabs)
  TEXT tx_ed_mat 530 222 260 ., label("Mata matrix to declare (instead of varlist)")
  EDIT ed_mat 800 222 190 ., nomem option(mat)
  TEXT tx_cx_undirected 530 250 260 ., label("Force network to be undirected")
  CHECKBOX cx_undirected 800 250 190 ., label("undirected") option(undirected)
  TEXT tx_cx_directed 530 278 260 ., label("Force network to be directed")
  CHECKBOX cx_directed 800 278 190 ., label("directed") option(directed)
  TEXT tx_vr_time 530 306 260 ., label("Temporal snapshots: time variable")
  VARNAME vr_time 800 306 190 ., nomem option(time)
  TEXT tx_ed_interval 530 334 260 ., label("Temporal intervals: start and end variables")
  EDIT ed_interval 800 334 190 ., nomem option(interval)
  TEXT tx_vr_eventtime 530 362 260 ., label("Temporal events: event-time variable")
  VARNAME vr_eventtime 800 362 190 ., nomem option(eventtime)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwset"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwset " main.vl_vars
	beginoptions
		option main.cx_valued
		option main.cx_unvalued
		optionarg main.ed_nodenames
		option main.cx_overwrite
		option main.cx_replace
		option main.cx_bipartite
		option main.cx_twomode
		optionarg main.vr_biprownames
		option main.cx_selfloop
		optionarg main.ed_labs
		optionarg main.ed_vars
		option main.cx_keeporiginal
		option main.cx_xvars
		option main.cx_clear
		option main.cx_nwclear
		option main.cx_nooutput
		option main.cx_edgelist
		optionarg main.cb_name
		optionarg main.vr_labsfromvar
		optionarg main.ed_edgelabs
		optionarg main.ed_mat
		option main.cx_undirected
		option main.cx_directed
		optionarg main.vr_time
		optionarg main.ed_interval
		optionarg main.vr_eventtime
	endoptions
	stata
END
