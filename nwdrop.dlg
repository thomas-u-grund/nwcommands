VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdrop")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 142

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdrop - Drop networks or network nodes")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 48, label("Options")
  TEXT tx_cx_clean 20 54 260 ., label("Drop node observations")
  CHECKBOX cx_clean 290 54 190 ., label("clean") option(clean)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdrop"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdrop " main.cb_net
	beginoptions
		option main.cx_clean
	endoptions
	stata
END
