VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsmall")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsmall - Generate a small-world network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Number of nodes:")
  EDIT cb_net 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 1030 160, label("Options")
  TEXT tx_sp_k 20 54 260 ., label("Required. Number of neighbors on each side of the ring lattice")
  SPINNER sp_k 290 54 70 ., default(1) max(999999) min(1) nomem option(k)
  TEXT tx_ed_weights 20 82 260 ., label("probabilities p_k for tie weights k")
  EDIT ed_weights 290 82 190 ., nomem option(weights)
  TEXT tx_sp_ntimes 20 110 260 ., label("number of small-world networks to be generated; default = 1")
  SPINNER sp_ntimes 290 110 70 ., default(1) max(999999) min(1) nomem option(ntimes)
  TEXT tx_ed_labs 20 138 260 ., label("overwrite node labels")
  EDIT ed_labs 290 138 190 ., nomem option(labs)
  TEXT tx_cb_name 20 166 260 ., label("name of the new network")
  COMBOBOX cb_name 290 166 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_ed_prob 530 54 260 ., label("probability for a tie to rewire")
  EDIT ed_prob 800 54 190 ., nomem option(prob)
  TEXT tx_ed_shortcuts 530 82 260 ., label("exact number of ties to rewire")
  EDIT ed_shortcuts 800 82 190 ., nomem option(shortcuts)
  TEXT tx_cx_undirected 530 110 260 ., label("generate an undirected network; default = directed")
  CHECKBOX cx_undirected 800 110 190 ., label("undirected") option(undirected)
  TEXT tx_cx_noreplace 530 138 260 ., label("Do not replace an existing network of that name")
  CHECKBOX cx_noreplace 800 138 190 ., label("noreplace") option(noreplace)
  TEXT tx_cx_xvars 530 166 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 800 166 190 ., label("xvars") option(xvars)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsmall"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.cb_net.isneq("") & !main.cb_net.isNumlistGT(0) {
		stopbox stop "Number of nodes: enter a whole number greater than 0."
	}
	if main.ed_prob.isneq("") & !main.ed_prob.isnumlist() {
		stopbox stop "probability for a tie to rewire: enter a number (or numbers)."
	}
	if main.ed_shortcuts.isneq("") & !main.ed_shortcuts.isnumlist() {
		stopbox stop "exact number of ties to rewire: enter a number (or numbers)."
	}
	if main.ed_weights.isneq("") & !main.ed_weights.isnumlist() {
		stopbox stop "probabilities p_k for tie weights k: enter a number (or numbers)."
	}
	require main.cb_net
	put "nwsmall " main.cb_net
	beginoptions
		optionarg main.sp_k
		optionarg main.ed_weights
		optionarg main.sp_ntimes
		optionarg main.ed_labs
		optionarg main.cb_name
		optionarg main.ed_prob
		optionarg main.ed_shortcuts
		option main.cx_undirected
		option main.cx_noreplace
		option main.cx_xvars
	endoptions
	stata
END
