VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwqap")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 478

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwqap - Multivariate QAP regression")
BEGIN
  TEXT tx_net 20 20 260 ., label("Formula: dependent net, then predictor nets:")
  EDIT cb_net 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 520 384, label("Options")
  TEXT tx_cx_detail 20 54 260 ., label("display details of regression results")
  CHECKBOX cx_detail 290 54 190 ., label("detail") option(detail)
  TEXT tx_ed_type 20 82 260 ., label("Dyad regression command; default = logit")
  EDIT ed_type 290 82 190 ., nomem option(type)
  TEXT tx_ed_typeoptions 20 110 260 ., label("Options passed on to the regression command")
  EDIT ed_typeoptions 290 110 190 ., nomem option(typeoptions)
  TEXT tx_ed_mode 20 138 260 ., label("modes for expanding variables to networks")
  EDIT ed_mode 290 138 190 ., nomem option(mode)
  TEXT tx_sp_permutations 20 166 260 ., label("number of QAP permutations; default = 500")
  SPINNER sp_permutations 290 166 70 ., default(500) max(999999) min(1) nomem option(permutations)
  TEXT tx_ed_save 20 194 260 ., label("save coefficients from permutations in file")
  EDIT ed_save 290 194 190 ., nomem option(save)
  TEXT tx_cb_predict 20 222 260 ., label("Store the fitted dyad-level values")
  COMBOBOX cb_predict 290 222 190 ., dropdown contents(netlist) nomem option(predict)
  TEXT tx_cx_qapspp 20 250 260 ., label("Double semi-partialling QAP (MRQAP)")
  CHECKBOX cx_qapspp 290 250 190 ., label("qapspp") option(qapspp)
  TEXT tx_cx_plot 20 278 260 ., label("Histogram + reference line, one per coefficient")
  CHECKBOX cx_plot 290 278 190 ., label("plot") option(plot)
  TEXT tx_ed_name 20 306 260 ., label("name for the graph created by plot")
  EDIT ed_name 290 306 190 ., nomem option(name)
  TEXT tx_cx_force 20 334 260 ., label("Run despite the time or memory guard")
  CHECKBOX cx_force 290 334 190 ., label("force") option(force)
  TEXT tx_gsaving 20 362 260 ., label("Save the graph to a file (.gph)")
  FILE fi_gsaving 290 362 190 ., save nomem option(gsaving)
  TEXT tx_export 20 390 260 ., label("Export the graph to a file (.png, .pdf, ...)")
  FILE fi_export 290 390 190 ., save nomem option(export)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwqap"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.cb_net
	put "nwqap " main.cb_net
	beginoptions
		option main.cx_detail
		optionarg main.ed_type
		optionarg main.ed_typeoptions
		optionarg main.ed_mode
		optionarg main.sp_permutations
		optionarg main.ed_save
		optionarg main.cb_predict
		option main.cx_qapspp
		option main.cx_plot
		optionarg main.ed_name
		option main.cx_force
		optionarg main.fi_gsaving
		optionarg main.fi_export
	endoptions
	stata
END
