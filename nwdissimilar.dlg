VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwdissimilar")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwdissimilar - Generate node dissimilarities")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_cb_type 20 54 260 ., label("Type of dissimilarity between two nodes; default = euclidean")
  COMBOBOX cb_type 290 54 190 ., dropdownlist contents(list_type) nomem option(type)
  TEXT tx_ed_labs 20 82 260 ., label("overwrite node labels; default = the source network's own labels")
  EDIT ed_labs 290 82 190 ., nomem option(labs)
  TEXT tx_ed_vars 20 110 260 ., label("new variables that are used for the network")
  EDIT ed_vars 290 110 190 ., nomem option(vars)
  TEXT tx_cb_name 20 138 260 ., label("Name of the new dissimilarity network; default =")
  COMBOBOX cb_name 290 138 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cb_context 20 166 260 ., label("Context definition for dissimilarity calculation; default = both")
  COMBOBOX cb_context 290 166 190 ., dropdownlist contents(list_context) nomem option(context)
  TEXT tx_cx_xvars 20 194 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 194 190 ., label("xvars") option(xvars)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_type
BEGIN
	euclidean
	manhatten
	hamming
	jaccard
	nonmatches
END

LIST list_context
BEGIN
	both
	incoming
	outgoing
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwdissimilar"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwdissimilar " main.cb_net
	beginoptions
		optionarg main.cb_type
		optionarg main.ed_labs
		optionarg main.ed_vars
		optionarg main.cb_name
		optionarg main.cb_context
		option main.cx_xvars
	endoptions
	stata
END
