VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwclustering")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 338

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwclustering - Clustering coefficient (transitivity) of a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 244, label("Options")
  TEXT tx_ed_measure 20 54 260 ., label("How to combine the two tie")
  EDIT ed_measure 290 54 190 ., nomem option(measure)
  TEXT tx_cx_symmetrize 20 82 260 ., label("Symmetrize a directed network before calculating (required for any")
  CHECKBOX cx_symmetrize 290 82 190 ., label("symmetrize") option(symmetrize)
  TEXT tx_ed_generate 20 110 260 ., label("Name of the Stata variable that stores each node's own")
  EDIT ed_generate 290 110 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 138 260 ., label("Overwrite an existing generate() variable; required if it already exists")
  CHECKBOX cx_replace 290 138 190 ., label("replace") option(replace)
  TEXT tx_cx_silent 20 166 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 166 190 ., label("silent") option(silent)
  TEXT tx_cx_onemode 20 194 260 ., label("Two-mode network: one-mode clustering of the bipartite graph (default: two-mode)")
  CHECKBOX cx_onemode 290 194 190 ., label("onemode") option(onemode)
  TEXT tx_cx_ra 20 222 260 ., label("Two-mode network: Robins-Alexander coefficient")
  CHECKBOX cx_ra 290 222 190 ., label("ra") option(ra)
  TEXT tx_cx_level 20 250 260 ., label("Two-mode network: level of the nodes to cluster (1 or 2)")
  EDIT ed_level 290 250 100 ., numonly nomem option(level)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwclustering"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwclustering " main.cb_net
	beginoptions
		optionarg main.ed_measure
		option main.cx_symmetrize
		optionarg main.ed_generate
		option main.cx_replace
		option main.cx_silent
		option main.cx_onemode
		option main.cx_ra
		optionarg main.ed_level
	endoptions
	stata
END
