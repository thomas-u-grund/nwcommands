VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcontext")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 310

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcontext - Create a context variable")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_vr_attribute 20 54 260 ., label("Attribute variable")
  VARNAME vr_attribute 290 54 190 ., nomem option(attribute)
  TEXT tx_cb_stat 20 82 260 ., label("Statistic that is used to calculate context variable for node i from attributes ")
  COMBOBOX cb_stat 290 82 190 ., dropdownlist contents(list_stat) nomem option(stat)
  TEXT tx_cb_mode 20 110 260 ., label("Define network neighbors of node i as either nodes j who receive ties from i, se")
  COMBOBOX cb_mode 290 110 190 ., dropdownlist contents(list_mode) nomem option(mode)
  TEXT tx_ed_generate 20 138 260 ., label("Name of the context variable to be generated; default =")
  EDIT ed_generate 290 138 190 ., nomem option(generate)
  TEXT tx_ed_mat 20 166 260 ., label("Store the result in a Mata matrix of this name instead of generating a Stata var")
  EDIT ed_mat 290 166 190 ., nomem option(mat)
  TEXT tx_cx_noweight 20 194 260 ., label("Ignore valued ties and treats all as binary")
  CHECKBOX cx_noweight 290 194 190 ., label("noweight") option(noweight)
  TEXT tx_cx_replace 20 222 260 ., label("Replace 's target variable if it already exists")
  CHECKBOX cx_replace 290 222 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_stat
BEGIN
	mean
	max
	min
	sum
	sd
	meanego
	maxego
	minego
	sumego
	sdego
END

LIST list_mode
BEGIN
	outgoing
	incoming
	both
	either
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcontext"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.vr_attribute
	put "nwcontext " main.cb_net
	beginoptions
		optionarg main.vr_attribute
		optionarg main.cb_stat
		optionarg main.cb_mode
		optionarg main.ed_generate
		optionarg main.ed_mat
		option main.cx_noweight
		option main.cx_replace
	endoptions
	stata
END
