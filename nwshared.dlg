VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwshared")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwshared - Calculate number of shared neighbors between nodes and...")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_cb_name 20 54 260 ., label("Save as new network; default")
  COMBOBOX cb_name 290 54 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cx_nwreplace 20 82 260 ., label("Nwreplace")
  CHECKBOX cx_nwreplace 290 82 190 ., label("nwreplace") option(nwreplace)
  TEXT tx_cx_replace 20 110 260 ., label("if a network named  already exists, drop it and use this name anyway (alias: , k")
  CHECKBOX cx_replace 290 110 190 ., label("replace") option(replace)
  TEXT tx_cx_undirected 20 138 260 ., label("Treat all ties as undirected for calculation")
  CHECKBOX cx_undirected 290 138 190 ., label("undirected") option(undirected)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwshared"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwshared " main.cb_net
	beginoptions
		optionarg main.cb_name
		option main.cx_nwreplace
		option main.cx_replace
		option main.cx_undirected
	endoptions
	stata
END
