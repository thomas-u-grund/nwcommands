VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwtomatafast")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 114

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwtomatafast - Return link to adjacency matrix of network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwtomatafast"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwtomatafast " main.cb_net
	stata
END
