VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwbalance")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 142

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwbalance - Structural balance of a signed network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 48, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Up to 3 names, for the per-node balance ratio, count of balanced")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwbalance"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwbalance " main.cb_net
	beginoptions
		optionarg main.ed_generate
	endoptions
	stata
END
