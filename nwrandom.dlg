VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwrandom")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwrandom - Generate a random network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 1030 188, label("Options")
  TEXT tx_ed_weights 20 54 260 ., label("probabilities p_k for tie weights k")
  EDIT ed_weights 290 54 190 ., nomem option(weights)
  TEXT tx_cx_selfloop 20 82 260 ., label("allow self-loops (a node tied to itself) in the generated network; default = no ")
  CHECKBOX cx_selfloop 290 82 190 ., label("selfloop") option(selfloop)
  TEXT tx_sp_ntimes 20 110 260 ., label("number of random networks to be generated; default = 1")
  SPINNER sp_ntimes 290 110 70 ., default(1) max(999999) min(-999999) nomem option(ntimes)
  TEXT tx_ed_census 20 138 260 ., label("dyad census of the new network")
  EDIT ed_census 290 138 190 ., nomem option(census)
  TEXT tx_ed_density 20 166 260 ., label("exact density of the new network")
  EDIT ed_density 290 166 190 ., nomem option(density)
  TEXT tx_ed_prob 20 194 260 ., label("probability for a tie")
  EDIT ed_prob 290 194 190 ., nomem option(prob)
  TEXT tx_ed_labs 530 54 260 ., label("overwrite node labels")
  EDIT ed_labs 800 54 190 ., nomem option(labs)
  TEXT tx_cb_name 530 82 260 ., label("name of the new random network; default =")
  COMBOBOX cb_name 800 82 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cx_undirected 530 110 260 ., label("generate an undirected network; default = directed")
  CHECKBOX cx_undirected 800 110 190 ., label("undirected") option(undirected)
  TEXT tx_cx_xvars 530 138 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 800 138 190 ., label("xvars") option(xvars)
  TEXT tx_cx_noreplace 530 166 260 ., label("reserved; currently a no-op - the create/replace collision guard on  already app")
  CHECKBOX cx_noreplace 800 166 190 ., label("noreplace") option(noreplace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwrandom"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwrandom " main.cb_net
	beginoptions
		optionarg main.ed_weights
		option main.cx_selfloop
		optionarg main.sp_ntimes
		optionarg main.ed_census
		optionarg main.ed_density
		optionarg main.ed_prob
		optionarg main.ed_labs
		optionarg main.cb_name
		option main.cx_undirected
		option main.cx_xvars
		option main.cx_noreplace
	endoptions
	stata
END
