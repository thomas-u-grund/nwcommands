VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwrandom")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 1060 338

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwrandom - Generate a random network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Number of nodes:")
  EDIT cb_net 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 1030 244, label("Options")
  TEXT tx_ed_weights 20 54 260 ., label("probabilities p_k for tie weights k")
  EDIT ed_weights 290 54 190 ., nomem option(weights)
  TEXT tx_cx_selfloop 20 82 260 ., label("allow self-loops (a node tied to itself) in the generated network; default = no ")
  CHECKBOX cx_selfloop 290 82 190 ., label("selfloop") option(selfloop)
  TEXT tx_sp_ntimes 20 110 260 ., label("number of random networks to be generated; default = 1")
  SPINNER sp_ntimes 290 110 70 ., default(1) max(999999) min(1) nomem option(ntimes)
  TEXT tx_ed_census 20 138 260 ., label("dyad census of the new network")
  EDIT ed_census 290 138 190 ., nomem option(census)
  TEXT tx_ed_density 20 166 260 ., label("exact density of the new network")
  EDIT ed_density 290 166 190 ., nomem option(density)
  TEXT tx_ed_prob 20 194 260 ., label("probability for a tie")
  EDIT ed_prob 290 194 190 ., nomem option(prob)
  TEXT tx_ed_degree 20 222 260 ., label("degree of every node (numbers or a variable); undirected")
  EDIT ed_degree 290 222 190 ., nomem option(degree)
  TEXT tx_ed_outdegree 20 250 260 ., label("out-degree of every node (with in-degree); directed")
  EDIT ed_outdegree 290 250 190 ., nomem option(outdegree)
  TEXT tx_ed_indegree 530 222 260 ., label("in-degree of every node (with out-degree); directed")
  EDIT ed_indegree 800 222 190 ., nomem option(indegree)
  TEXT tx_sp_swaps 530 250 260 ., label("degree(): number of tie swaps; default = 10 x ties")
  SPINNER sp_swaps 800 250 70 ., default(-1) max(999999999) min(-1) nomem option(swaps)
  TEXT tx_ed_labs 530 54 260 ., label("overwrite node labels")
  EDIT ed_labs 800 54 190 ., nomem option(labs)
  TEXT tx_cb_name 530 82 260 ., label("Name of the new random network; default = random")
  COMBOBOX cb_name 800 82 190 ., dropdown contents(netlist) nomem option(name)
  TEXT tx_cx_undirected 530 110 260 ., label("generate an undirected network; default = directed")
  CHECKBOX cx_undirected 800 110 190 ., label("undirected") option(undirected)
  TEXT tx_cx_xvars 530 138 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 800 138 190 ., label("xvars") option(xvars)
  TEXT tx_cx_noreplace 530 166 260 ., label("Do not replace an existing network of that name")
  CHECKBOX cx_noreplace 800 166 190 ., label("noreplace") option(noreplace)
  TEXT tx_cx_directed 530 194 260 ., label("Directed network (the default; no-op)")
  CHECKBOX cx_directed 800 194 190 ., label("directed") option(directed)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwrandom"
	stata hidden immediate
END

PROGRAM command
BEGIN
	// number fields: refuse text before the command runs
	if main.cb_net.isneq("") & !main.cb_net.isNumlistGT(0) {
		stopbox stop "Number of nodes: enter a whole number greater than 0."
	}
	if main.ed_census.isneq("") & !main.ed_census.isnumlist() {
		stopbox stop "dyad census of the new network: enter a number (or numbers)."
	}
	if main.ed_density.isneq("") & !main.ed_density.isnumlist() {
		stopbox stop "exact density of the new network: enter a number (or numbers)."
	}
	if main.ed_prob.isneq("") & !main.ed_prob.isnumlist() {
		stopbox stop "probability for a tie: enter a number (or numbers)."
	}
	if main.ed_weights.isneq("") & !main.ed_weights.isnumlist() {
		stopbox stop "probabilities p_k for tie weights k: enter a number (or numbers)."
	}
	require main.cb_net
	put "nwrandom " main.cb_net
	beginoptions
		optionarg main.ed_weights
		option main.cx_selfloop
		optionarg main.sp_ntimes
		optionarg main.ed_census
		optionarg main.ed_density
		optionarg main.ed_prob
		optionarg main.ed_degree
		optionarg main.ed_outdegree
		optionarg main.ed_indegree
		optionarg main.sp_swaps
		optionarg main.ed_labs
		optionarg main.cb_name
		option main.cx_undirected
		option main.cx_directed
		option main.cx_xvars
		option main.cx_noreplace
	endoptions
	stata
END
