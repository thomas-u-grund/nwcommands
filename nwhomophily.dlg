VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwhomophily")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 310

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwhomophily - Generate a homophily network")
BEGIN
  TEXT tx_vars 20 20 260 ., label("Variables (define the network):")
  VARLIST vl_vars 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_ed_homophily 20 54 260 ., label("degree of homophily for each variable in")
  EDIT ed_homophily 290 54 190 ., nomem option(homophily)
  TEXT tx_ed_density 20 82 260 ., label("density of the new network")
  EDIT ed_density 290 82 100 ., numonly nomem option(density)
  TEXT tx_ed_mode 20 110 260 ., label("mode used to generate probabilities for ties")
  EDIT ed_mode 290 110 190 ., nomem option(mode)
  TEXT tx_ed_nodes 20 138 260 ., label("number of nodes; if not specified the number of valid cases of {it:} is used")
  EDIT ed_nodes 290 138 190 ., nomem option(nodes)
  TEXT tx_ed_name 20 166 260 ., label("name of the new random network")
  EDIT ed_name 290 166 190 ., nomem option(name)
  TEXT tx_cx_xvars 20 194 260 ., label("generate Stata variables for the network")
  CHECKBOX cx_xvars 290 194 190 ., label("xvars") option(xvars)
  TEXT tx_cx_undirected 20 222 260 ., label("Undirected")
  CHECKBOX cx_undirected 290 222 190 ., label("undirected") option(undirected)
END

PROGRAM initialize
BEGIN
END

PROGRAM command
BEGIN
	require main.ed_homophily
	require main.ed_density
	put "nwhomophily " main.vl_vars
	beginoptions
		optionarg main.ed_homophily
		optionarg main.ed_density
		optionarg main.ed_mode
		optionarg main.ed_nodes
		optionarg main.ed_name
		option main.cx_xvars
		option main.cx_undirected
	endoptions
	stata
END
