VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwuse")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 198

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwuse - Load Stata network dataset")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 104, label("Options")
  TEXT tx_cx_nwclear 20 54 260 ., label("clear memory before loading dataset")
  CHECKBOX cx_nwclear 290 54 190 ., label("nwclear") option(nwclear)
  TEXT tx_cx_nwappend 20 82 260 ., label("append to existing data")
  CHECKBOX cx_nwappend 290 82 190 ., label("nwappend") option(nwappend)
  TEXT tx_cx_force 20 110 260 ., label("when combined with , if the incoming data contains a network with the same name ")
  CHECKBOX cx_force 290 110 190 ., label("force") option(force)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwuse"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwuse " main.cb_net
	beginoptions
		option main.cx_nwclear
		option main.cx_nwappend
		option main.cx_force
	endoptions
	stata
END
