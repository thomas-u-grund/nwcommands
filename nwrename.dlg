VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwrename")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 520 142

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwrename - Rename a network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Old network name:")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 480 58, label("Details")
  TEXT tx_ed_new 20 54 260 ., label("New network name:")
  EDIT ed_new 290 54 190 ., nomem
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwrename"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.ed_new
	put "nwrename " main.cb_net " " main.ed_new
	stata
END
