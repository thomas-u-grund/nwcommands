VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsync")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 170

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsync - Sync network with Stata variables")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 76, label("Options")
  TEXT tx_cx_label 20 54 260 ., label("Sync the node labels")
  CHECKBOX cx_label 290 54 190 ., label("label") option(label)
  TEXT tx_cx_fromstata 20 82 260 ., label("Change the direction of the sync")
  CHECKBOX cx_fromstata 290 82 190 ., label("fromstata") option(fromstata)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsync"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsync " main.cb_net
	beginoptions
		option main.cx_label
		option main.cx_fromstata
	endoptions
	stata
END
