VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nw2fromedge")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 142

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nw2fromedge - Import two-mode network data from edgelist")
BEGIN
  TEXT tx_vars 20 20 260 ., label("Variables (define the network):")
  VARLIST vl_vars 290 20 190 ., nomem
  GROUPBOX gb_opt 10 44 520 48, label("Options")
  TEXT tx_cx_xvars 20 54 260 ., label("Xvars")
  CHECKBOX cx_xvars 290 54 190 ., label("xvars") option(xvars)
END

PROGRAM initialize
BEGIN
END

PROGRAM command
BEGIN
	put "nw2fromedge " main.vl_vars
	beginoptions
		option main.cx_xvars
	endoptions
	stata
END
