VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwcorrelate")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 394

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwcorrelate - Correlate networks and variables")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 300, label("Options")
  TEXT tx_vr_attribute 20 54 260 ., label("Node attribute to correlate with the network (instead of a second network)")
  VARNAME vr_attribute 290 54 190 ., nomem option(attribute)
  TEXT tx_ed_context 20 82 260 ., label("Ties used for node correlations: outgoing, incoming or both")
  EDIT ed_context 290 82 190 ., nomem option(context)
  TEXT tx_ed_name 20 110 260 ., label("Name of the new network with node correlations")
  EDIT ed_name 290 110 190 ., nomem option()
  TEXT tx_ed_mode 20 138 260 ., label("Attribute expansion mode (e.g. same, absdist)")
  EDIT ed_mode 290 138 190 ., nomem option(mode)
  TEXT tx_cx_keepexpand 20 166 260 ., label("Keep the network made by nwexpand")
  CHECKBOX cx_keepexpand 290 166 190 ., label("keepexpand") option(keepexpand)
  TEXT tx_ed_permutations 20 194 260 ., label("Number of QAP permutations; default = 1")
  EDIT ed_permutations 290 194 190 ., nomem option(permutations)
  TEXT tx_ed_save 20 222 260 ., label("Save the permutation results in this file")
  EDIT ed_save 290 222 190 ., nomem option(save)
  TEXT tx_cx_force 20 250 260 ., label("Run despite the memory guard")
  CHECKBOX cx_force 290 250 190 ., label("force") option(force)
  TEXT tx_cx_undirected 20 278 260 ., label("Store the node correlations as an undirected network")
  CHECKBOX cx_undirected 290 278 190 ., label("undirected") option(undirected)
  TEXT tx_cx_directed 20 306 260 ., label("Store the node correlations as a directed network")
  CHECKBOX cx_directed 290 306 190 ., label("directed") option(directed)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwcorrelate"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwcorrelate " main.cb_net
	beginoptions
		optionarg main.vr_attribute
		optionarg main.ed_context
		optionarg main.ed_name
		optionarg main.ed_mode
		option main.cx_keepexpand
		optionarg main.ed_permutations
		optionarg main.ed_save
		option main.cx_force
		option main.cx_undirected
		option main.cx_directed
	endoptions
	stata
END
