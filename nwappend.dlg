VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwappend")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 142

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwappend - Append network dataset")
BEGIN
  TEXT tx_using 20 20 260 ., label("Network dataset to append (.dta):")
  FILE fi_using 290 20 190 ., label("Browse...") filter("Stata data|*.dta|All files|*.*") defext(dta) nomem
  GROUPBOX gb_opt 10 44 520 48, label("Options")
  TEXT tx_cx_force 20 54 260 ., label("If a network in using dataset has the same name as one already loaded")
  CHECKBOX cx_force 290 54 190 ., label("force") option(force)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwappend"
	stata hidden immediate
END

PROGRAM command
BEGIN
	require main.fi_using
	put "nwappend using " `"""' main.fi_using `"""'
	beginoptions
		option main.cx_force
	endoptions
	stata
END
