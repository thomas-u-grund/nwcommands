VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwspmatrix")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 270

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwspmatrix - Spatial weighting matrix from a network, for spregress")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network:")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 216, label("Options")
  TEXT tx_name 20 54 260 ., label("Name of the weighting matrix (default W)")
  EDIT ed_name 290 54 190 ., nomem option(name)
  TEXT tx_weights 20 82 260 ., label("Ties as 0/1 or with their values")
  COMBOBOX cb_weights 290 82 190 ., dropdownlist contents(list_weights) nomem option(weights)
  TEXT tx_direction 20 110 260 ., label("How to read directed ties")
  COMBOBOX cb_direction 290 110 190 ., dropdownlist contents(list_direction) nomem option(direction)
  TEXT tx_normalize 20 138 260 ., label("Normalisation")
  COMBOBOX cb_normalize 290 138 190 ., dropdownlist contents(list_normalize) nomem option(normalize)
  TEXT tx_idvar 20 166 260 ., label("Numeric variable that identifies the nodes in the data")
  VARNAME vn_idvar 290 166 190 ., nomem option(idvar)
  TEXT tx_matrix 20 194 260 ., label("Also store the matrix as an ordinary Stata matrix")
  EDIT ed_matrix 290 194 190 ., nomem option(matrix)
  TEXT tx_replace 20 222 260 ., label("Overwrite an existing weighting matrix")
  CHECKBOX cx_replace 290 222 90 ., label("replace") option(replace)
  CHECKBOX cx_silent 390 222 120 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST list_weights
BEGIN
	binary
	valued
END

LIST list_direction
BEGIN
	out
	in
	symmetric
	mutual
END

LIST list_normalize
BEGIN
	row
	none
	spectral
	minmax
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwspmatrix"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwspmatrix " main.cb_net
	beginoptions
		optionarg main.ed_name
		optionarg main.cb_weights
		optionarg main.cb_direction
		optionarg main.cb_normalize
		optionarg main.vn_idvar
		optionarg main.ed_matrix
		option main.cx_replace
		option main.cx_silent
	endoptions
	stata
END
