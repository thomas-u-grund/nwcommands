VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwconcor")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 282

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwconcor - CONCOR structural-equivalence blockmodel")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 188, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Name of the Stata variable that stores block membership; default =")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_sp_splits 20 110 260 ., label("Number of recursive bisections; final number of blocks is up to 2^; default = 1")
  SPINNER sp_splits 290 110 70 ., default(1) max(999999) min(-999999) nomem option(splits)
  TEXT tx_ed_measure 20 138 260 ., label("Whether to use tie values () or only presence/absence of ties (); default =  for")
  EDIT ed_measure 290 138 190 ., nomem option(measure)
  TEXT tx_sp_maxiter 20 166 260 ., label("Maximum number of correlation iterations per split before giving up on convergen")
  SPINNER sp_maxiter 290 166 70 ., default(25) max(999999) min(-999999) nomem option(maxiter)
  TEXT tx_cx_silent 20 194 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 194 190 ., label("silent") option(silent)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwconcor"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwconcor " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		optionarg main.sp_splits
		optionarg main.ed_measure
		optionarg main.sp_maxiter
		option main.cx_silent
	endoptions
	stata
END
