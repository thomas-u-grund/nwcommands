VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nw2clustering")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 226

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nw2clustering - Clustering coefficient (transitivity) of a two-mode network")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 132, label("Options")
  TEXT tx_ed_measure 20 54 260 ., label("How to combine a 4-path's own")
  EDIT ed_measure 290 54 190 ., nomem option(measure)
  TEXT tx_sp_level 20 82 260 ., label("Which mode (1 or 2) to compute clustering scores for; default = 1")
  SPINNER sp_level 290 82 70 ., default(1) max(999999) min(-999999) nomem option(level)
  TEXT tx_ed_generate 20 110 260 ., label("Name of the Stata variable that stores each -mode")
  EDIT ed_generate 290 110 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 138 260 ., label("Overwrite an existing  variable; required if it already exists")
  CHECKBOX cx_replace 290 138 190 ., label("replace") option(replace)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nw2clustering"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nw2clustering " main.cb_net
	beginoptions
		optionarg main.ed_measure
		optionarg main.sp_level
		optionarg main.ed_generate
		option main.cx_replace
	endoptions
	stata
END
