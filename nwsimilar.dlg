VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsimilar")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsimilar - Generate node similarities")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 160, label("Options")
  TEXT tx_ed_type 20 54 260 ., label("Type of similarity between two nodes; default = pearson")
  EDIT ed_type 290 54 190 ., nomem option(type)
  TEXT tx_ed_name 20 82 260 ., label("Name of the new similarity network; default =")
  EDIT ed_name 290 82 190 ., nomem option(name)
  TEXT tx_ed_mode 20 110 260 ., label("Mode")
  EDIT ed_mode 290 110 190 ., nomem option(mode)
  TEXT tx_ed_context 20 138 260 ., label("Context definition for similarity calculation; default = both (alias: , kept for")
  EDIT ed_context 290 138 190 ., nomem option(context)
  TEXT tx_cx_xvars 20 166 260 ., label("Generate Stata variables for the network")
  CHECKBOX cx_xvars 290 166 190 ., label("xvars") option(xvars)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsimilar"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsimilar " main.cb_net
	beginoptions
		optionarg main.ed_type
		optionarg main.ed_name
		optionarg main.ed_mode
		optionarg main.ed_context
		option main.cx_xvars
	endoptions
	stata
END
