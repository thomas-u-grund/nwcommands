VERSION 10
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nw2degree")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 550 254

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nw2degree - Two-mode (bipartite) degree centrality")
BEGIN
  TEXT tx_net 20 20 260 ., label("Network(s):")
  COMBOBOX cb_net 290 20 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_opt 10 44 520 160, label("Options")
  TEXT tx_ed_generate 20 54 260 ., label("Required. Name of the Stata variable that stores two-mode degree centrality")
  EDIT ed_generate 290 54 190 ., nomem option(generate)
  TEXT tx_cx_replace 20 82 260 ., label("Replace existing variable")
  CHECKBOX cx_replace 290 82 190 ., label("replace") option(replace)
  TEXT tx_cx_silent 20 110 260 ., label("Suppress display of results")
  CHECKBOX cx_silent 290 110 190 ., label("silent") option(silent)
  TEXT tx_cx_binary 20 138 260 ., label("Ignore the tie values of a valued network (default: use them)")
  CHECKBOX cx_binary 290 138 190 ., label("binary") option(binary)
  TEXT tx_cx_raw 20 166 260 ., label("Raw degree: not divided by the size of the other mode")
  CHECKBOX cx_raw 290 166 190 ., label("raw") option(raw)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

PROGRAM initialize
BEGIN
	put "_nwdialog nw2degree"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nw2degree " main.cb_net
	beginoptions
		optionarg main.ed_generate
		option main.cx_replace
		option main.cx_silent
		option main.cx_binary
		option main.cx_raw
	endoptions
	stata
END
